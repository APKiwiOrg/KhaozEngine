#!/bin/sh
# pre-commit: ban em/en-dashes in staged .md/.cs additions, ban prose semicolons in staged .md
# additions (scripts/check-prose.sh), and enforce the version<->changelog coupling. Shared via
# core.hooksPath=.githooks. Bypass with --no-verify.
fail=0

# 1) Em/en-dash in staged ADDED lines of shipped text (.md, .cs). Pre-existing dashes elsewhere
#    in a touched file are ignored; only what you are adding is checked.
added=$(git diff --cached --unified=0 -- '*.md' '*.cs' 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+')
if printf '%s' "$added" | LC_ALL=C grep -qF -e '—' -e '–'; then
  echo "pre-commit: staged .md/.cs additions contain an em-dash or en-dash (banned in shipped text)." >&2
  echo "            Fix them, or 'git commit --no-verify' to override." >&2
  fail=1
fi

# 1b) Prose-semicolon ban in staged ADDED lines of .md (scripts/check-prose.sh). Same staged contract
#     as the dash check above: semicolons already in the file are ignored, only what you are adding
#     counts, and code (fenced blocks, indented blocks, inline spans) is stripped before looking. Not
#     in CI yet: the docs predate the rule, so --tree still reports pre-existing hits fleet-wide.
if [ -f scripts/check-prose.sh ]; then
  if ! sh scripts/check-prose.sh; then
    echo "            Fix them, or 'git commit --no-verify' to override." >&2
    fail=1
  fi
fi

# 2) version<->changelog coupling. Engine (has check-doc-versions.sh) couples any version tag;
#    adopters couple the game version only (exclude the engine pin KhaozEngineVersion). LangVersion
#    is a compiler setting, not an app version, so it is excluded in both cases.
props=$(git diff --cached --name-only -- '*Directory.Build.props' 2>/dev/null)
if [ -n "$props" ]; then
  if [ -f scripts/check-doc-versions.sh ]; then
    excl='AssemblyVersion|LangVersion'
  else
    excl='KhaozEngineVersion|AssemblyVersion|LangVersion'
  fi
  changed_ver=$(git diff --cached -- '*Directory.Build.props' \
    | grep -E '^[+-]' | grep -vE '^[+-][+-]' \
    | grep -E '<[A-Za-z]*Version[A-Za-z]*>' | grep -vE "$excl")
  if [ -n "$changed_ver" ]; then
    if ! git diff --cached --name-only | grep -qiE 'CHANGELOG'; then
      echo "pre-commit: a version line changed in Directory.Build.props but no changelog file is staged." >&2
      echo "            Add the changelog entry in the same commit (or --no-verify)." >&2
      fail=1
    fi
  fi
fi

# 3) Engine only: catch version-doc drift when a props file is part of the commit.
if [ -f scripts/check-doc-versions.sh ] && [ -n "$props" ]; then
  if ! bash scripts/check-doc-versions.sh >/dev/null 2>&1; then
    echo "pre-commit: check-doc-versions.sh failed (engine version doc drift)." >&2
    echo "            Run ./scripts/check-doc-versions.sh to see the stale declaration." >&2
    fail=1
  fi
fi

# 4) Retired backlog files. docs/TODO.md and docs/ROADMAP.md were migrated to GitHub Issues on
#    2026-07-17 and deleted. Re-creating one restarts exactly the drift the migration ended, so a
#    commit that ADDS either (diff-filter=A, repo-root docs/ only) is blocked. Override BACKLOG_FILE_OK=1.
readded=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep -E '^docs/(TODO|ROADMAP)\.md$' || true)
if [ -n "$readded" ] && [ "${BACKLOG_FILE_OK:-}" != 1 ]; then
  echo "pre-commit: this commit re-creates a retired backlog file:" >&2
  for f in $readded; do echo "              $f" >&2; done
  echo "            The backlog is GitHub Issues now (migrated + deleted 2026-07-17), not a file. File it with:" >&2
  echo "              gh issue create --label kind/backlog --label confidence/lead" >&2
  echo "            Search prior art first: scripts/ledger.sh search <term>. Deliberate exception: BACKLOG_FILE_OK=1." >&2
  fail=1
fi

exit $fail
