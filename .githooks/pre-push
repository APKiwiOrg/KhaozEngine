#!/bin/sh
# pre-push: enforce branch-name convention and the release-tag standard; the engine also runs the
# doc-version check before the push triggers CI. Shared via core.hooksPath=.githooks.
# Bypass with `git push --no-verify`.
fail=0

refs_file=$(mktemp)
cat > "$refs_file"

# Shared release-tag standard (sourced so pre-push and scripts/tag-release.sh agree on one rule).
if [ -f scripts/tag-standard.sh ]; then . scripts/tag-standard.sh; have_tagstd=1; else have_tagstd=0; fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  [ "$local_ref" = "(delete)" ] && continue
  # all-zero local sha => ref deletion; allow it
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$local_ref" in
    refs/heads/*)
      br=${local_ref#refs/heads/}
      case "$br" in
        main|master)
          # VERSION PAST ITS RELEASE (issue #1033). The repo already refuses to TAG a taken version
          # (tag-collision-guard.sh) and to PACK one (pack-release-guard.sh), but nothing stopped the
          # push that leaves the integration branch SITTING on one, which is the state both of those
          # exist to prevent. It happened twice on 2026-09-20: a branch merged while a concurrent
          # session tagged the version it was staged into, so the knob named a released version and
          # that version's changelog entry described content its tag does not carry. Both needed a
          # repair commit that a refusal here would have turned into a bump before the push.
          #
          # Only the integration branch is asked. A side branch may legitimately sit at a released
          # version (a control harness pinned to an old tag is exactly that), so this would be noise
          # there. Documentation, tooling and governance ride a release without bumping by the
          # contributor rules, so tag_version_bearing lets those through: a guard that refuses a docs
          # commit for not bumping a version it is forbidden to bump is a guard people route around.
          if [ "$have_tagstd" = 1 ]; then
            pushver=$(git show "$local_sha:Directory.Build.props" 2>/dev/null | tag_props_version)
            if [ -n "$pushver" ] && [ "$(tag_release_window "$pushver" "$local_sha")" = past-tag ]; then
              tagc=$(git rev-parse -q --verify "refs/tags/v$pushver^{commit}" 2>/dev/null)
              tagshort=$(git rev-parse --short "$tagc" 2>/dev/null)
              if tag_version_bearing "$tagc" "$local_sha"; then
                echo "pre-push: '$br' is at version $pushver, but v$pushver is already released at $tagshort." >&2
                echo "          This push is past that tag and carries changes that ship inside a package," >&2
                echo "          so it would put a released version number on content no tag describes, and" >&2
                echo "          leave that version's changelog entry claiming content the tag does not carry." >&2
                echo "          Bump the version knob in Directory.Build.props, move your notes to the new" >&2
                echo "          entry, then push. Deliberate exception: 'git push --no-verify'." >&2
                fail=1
              fi
            fi
          fi ;;
        feature/*|fix/*|hotfix/*|worktree-*) : ;;
        *-promote) : ;;
        *)
          echo "pre-push: branch '$br' does not match the naming convention." >&2
          echo "          Allowed: main, feature/*, fix/*, hotfix/*, worktree-*, <batchN>-promote." >&2
          echo "          Rename before pushing, or 'git push --no-verify' to override." >&2
          fail=1 ;;
      esac ;;
    refs/tags/*)
      tag=${local_ref#refs/tags/}
      # Only govern version tags (vX.Y.Z); leave any other tag alone. Skip if the repo ships no standard.
      case "$tag" in
        v[0-9]*)
          if [ "$have_tagstd" != 1 ]; then
            : ;
          elif ! tag_name_ok "$tag"; then
            echo "pre-push: tag '$tag' is not vMAJOR.MINOR.PATCH." >&2
            echo "          Fix the tag name, or 'git push --no-verify' to override." >&2
            fail=1
          elif [ "$(git cat-file -t "$local_sha" 2>/dev/null)" != tag ]; then
            echo "pre-push: tag '$tag' is lightweight; release tags must be annotated." >&2
            echo "          Recreate it with scripts/tag-release.sh (or git tag -a $tag -m 'area(${tag#v}): summary')." >&2
            fail=1
          else
            subj=$(git for-each-ref --format='%(contents:subject)' "refs/tags/$tag" 2>/dev/null)
            ver=${tag#v}
            if ! tag_msg_ok "$subj" "$ver"; then
              echo "pre-push: tag '$tag' message must be 'area($ver): summary' (lowercase area, version scope, no dashes)." >&2
              echo "          got: $subj" >&2
              echo "          Use scripts/tag-release.sh, or 'git push --no-verify' to override." >&2
              fail=1
            else
              commit=$(git rev-list -n 1 "$local_sha" 2>/dev/null)
              pver=$(git show "$commit:Directory.Build.props" 2>/dev/null | tag_props_version)
              if [ -n "$pver" ] && [ "$pver" != "$ver" ]; then
                echo "pre-push: tag '$tag' does not match the version knob ($pver) in Directory.Build.props at the tagged commit." >&2
                echo "          Tag the commit whose version is $ver, or align the version, then re-tag." >&2
                fail=1
              fi
            fi
          fi ;;
      esac ;;
  esac
done < "$refs_file"

if [ -f scripts/check-doc-versions.sh ]; then
  if ! bash scripts/check-doc-versions.sh >/dev/null 2>&1; then
    echo "pre-push: check-doc-versions.sh failed. Fix the version doc drift before pushing (or --no-verify)." >&2
    fail=1
  fi
fi

rm -f "$refs_file"

exit $fail
