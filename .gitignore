# ===== Standard base (keep in sync across game repos; ASCII hyphens only, no em-dashes) =====
# EXTENSIBLE layer: everything between these two markers is byte-identical in every repo and is
# checked by scripts/check-template-sync.sh. Change it in game-template and re-propagate, never here.
# Repo-specific rules go BELOW the end marker, where they are yours and are never compared.
# Nothing in this block may contain a __GAME__ placeholder: substitution would make it un-comparable,
# which is exactly why local.settings.json went six repos without being ignored.

# Build outputs
**/bin/
**/obj/

# .NET / IDE
*.user
*.suo
*.sln.docstates
*.lscache
.vs/

# OS metadata
.DS_Store
**/.DS_Store
Thumbs.db

# Local environment / secrets
.env
.env.local
.env.*.local
.env.production

# Azure Functions local dev settings (may hold a local connection string); commit
# local.settings.json.example instead. See the game's status-function project + docs/SERVER-STATUS.md.
local.settings.json

# Local AI / tooling settings (the shared .claude/settings.json and .codex/settings.json are tracked)
.claude/settings.local.json
.codex/settings.local.json
.claude/worktrees/
.codex/worktrees/
.superpowers/
# Superpowers plan/spec output, local-only (never committed):
docs/superpowers/

# Build / publish artifacts (this is `artifacts/`, NOT the tracked `art-assets/icon/` source pack:
# the committed generated icon pack under art-assets/ is intentionally NOT ignored)
artifacts/

# ===== End standard base =====

# ----- KhaozEngine-specific (add repo-specific rules below) -----
# Failure-evidence PNGs written by the GPU golden compare (got/want/diff/bake); local-only, uploaded as CI artifacts
KhaozEngine.Render.Tests/Gpu/goldens-evidence/
# Emitted HLSL written by D3D11HlslByteEqualityTests when a pinned hash no longer matches; local-only,
# uploaded as a CI artifact so an option drift can be read rather than guessed at
KhaozEngine.Render.Tests/Gpu/hlsl-evidence/
# Compiled SPIR-V written by VulkanSpirvByteEqualityTests when a pinned hash no longer matches. Local-only,
# uploaded as a CI artifact so a front-end option drift can be disassembled rather than guessed at
KhaozEngine.Render.Tests/Gpu/spirv-evidence/
# CPU-vs-GPU skinning parity PNG dumps (Render3DGpuSkinningGpuTests); local-only diagnostic evidence
gpu-skinning-evidence/

# Dev-only local NuGet feed (packed packages live here; the durable store is GitHub Packages - see AGENTS.md)
local-feed/

# Runtime world DB written by the NetworkedWalkServer demo (SqliteWorldStore default path), plus its WAL/SHM sidecars
networked-walk-world.db
networked-walk-world.db-wal
networked-walk-world.db-shm

# Local mirror of the GitHub Issues backlog (scripts/ledger.sh sync). Derived, never a source of
# truth, and per-checkout. Kept out of git on purpose: a committed copy would drift and re-create
# the docs/TODO.md sync problem that moving to Issues was meant to end.
.ledger/

# Build-home workaround dirs used by agent worktrees (HOME redirect for the gitconfig TCC issue)
.buildhome/
.worktrees/
