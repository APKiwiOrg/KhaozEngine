<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Shared version for the 4.x MonoGame-based packages. Bump here to release them together. -->
    <Version>4.11.0</Version>
    <!-- Shared version for the 5.x experimental custom-stack (MonoGame-free) packages, which set
         <Version>$(KhaozEngine5xVersion)</Version> in their csproj. Bump here to release them together. -->
    <KhaozEngine5xVersion>5.16.0-experimental</KhaozEngine5xVersion>
    <Authors>APKiwi</Authors>
    <Company>Khaoz</Company>
    <PackageProjectUrl>https://github.com/APKiwi/KhaozEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/APKiwi/KhaozEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 APKiwi. All rights reserved.</Copyright>

    <!-- SourceLink + symbols so games keep step-into-source debugging. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Ship XML doc comments in the packages for IntelliSense. 1591 = "missing doc
         on public member": suppressed so partial coverage doesn't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
