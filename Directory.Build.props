<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Shared version for the 4.x LEGACY line: now ONLY the genuinely-MonoGame packages
         (Effects/Graphics/Input/Screens/Sprites/Time/UI), consumed by the still-4.x SpaceGame until it
         migrates. The MonoGame-free foundation packages that used to share this line graduated to the 5.x
         line at 5.46.0 (they set <Version>$(KhaozEngine5xVersion)</Version> in their csproj). This line is
         frozen-ish: bump only when a MonoGame package itself needs a release. -->
    <Version>4.12.0</Version>
    <!-- Shared version for the 5.x engine: the custom-stack (MonoGame-free) packages (KhaozEngine.Gpu,
         Windowing, Render2D, Render3D, Gui, Audio, Particles, Game) AND the graduated MonoGame-free
         foundation packages (Ecs/Serialization/Content/Content.Validator/Diagnostics/App/Localization/
         Persistence/Pooling/Platform/Updates/Collision/Netcode/Netcode.Abstractions/Netcode.LiteNetLib),
         which all set <Version>$(KhaozEngine5xVersion)</Version> in their csproj. No longer experimental as
         of 5.31.0; foundation graduated onto this line at 5.46.0 so a 5.x game pins only 5.x packages. Bump
         here to release them together; this is the version the doc-version guard checks. -->
    <KhaozEngine5xVersion>5.55.0</KhaozEngine5xVersion>
    <Authors>APKiwi</Authors>
    <Company>Khaoz</Company>
    <PackageProjectUrl>https://github.com/APKiwi/KhaozEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/APKiwi/KhaozEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 APKiwi. All rights reserved.</Copyright>

    <!-- SourceLink + symbols so games keep step-into-source debugging. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Ship XML doc comments in the packages for IntelliSense. 1591 = "missing doc
         on public member": suppressed so partial coverage doesn't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
