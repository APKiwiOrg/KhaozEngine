<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Build quality: warnings are errors in every config (the build rule shared across every
         KhaozEngine repo). Any compiler/analyzer warning fails the build, the tests, and CI, so the
         engine stays at zero warnings. Fix warnings at the source, not with a blanket suppression; the
         only standing suppression is 1591 (missing XML doc on public members), set below. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- The legacy 4.x MonoGame line is GONE: its six packages (Graphics/Input/Screens/Sprites/Time/UI) were
         deleted once SpaceGame, the last consumer, migrated off MonoGame. The engine is now
         entirely MonoGame-free, so there is a single shared version line below. (History: docs/ROADMAP.md
         "The post-MonoGame pivot".) -->
    <!-- Shared version for the engine (the WHOLE engine). Every packable package sets
         <Version>$(KhaozEngineVersion)</Version> in its csproj: the custom render/runtime stack (Gpu,
         Windowing, Render2D, Render3D, Gui, Audio, Particles, Game) plus the graduated MonoGame-free
         foundation (Ecs/Serialization/Content/Diagnostics/App/Locomotion/Objectives/Persistence/Platform/
         Updates/Collision/Physics/Physics.Bepu/Netcode/Netcode.Abstractions/Netcode.LiteNetLib/WorldStore/WorldStore.Sqlite/
         WorldStore.SqlServer/NetWorld). Bump here to release them together; this is the version the
         doc-version guard checks. -->
    <KhaozEngineVersion>10.40.0</KhaozEngineVersion>
    <Authors>APKiwi</Authors>
    <Company>Khaoz</Company>
    <PackageProjectUrl>https://github.com/APKiwi/KhaozEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/APKiwi/KhaozEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 APKiwi. All rights reserved.</Copyright>

    <!-- SourceLink + symbols so games keep step-into-source debugging. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Read only the repo's .git/config for SourceLink, never the global ~/.gitconfig.
         ~/.gitconfig is a symlink into iCloud here, and the File Provider intermittently
         denies the read mid-sync, failing the build with "Access to the path is denied".
         .git/config carries the remote URL + commit, which is all SourceLink needs; CI
         already forces this same scope. -->
    <GitRepositoryConfigurationScope>local</GitRepositoryConfigurationScope>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Ship XML doc comments in the packages for IntelliSense. 1591 = "missing doc
         on public member": suppressed so partial coverage doesn't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
