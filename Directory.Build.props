<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- The legacy 4.x MonoGame line is GONE: its six packages (Graphics/Input/Screens/Sprites/Time/UI) were
         deleted once SpaceGame, the last consumer, migrated off MonoGame to the 5.x stack. The engine is now
         entirely MonoGame-free, so there is a single shared version line below. (History: docs/ROADMAP.md
         "The post-MonoGame pivot".) -->
    <!-- Shared version for the 5.x engine - the WHOLE engine now. Every packable package sets
         <Version>$(KhaozEngine5xVersion)</Version> in its csproj: the custom render/runtime stack (Gpu,
         Windowing, Render2D, Render3D, Gui, Audio, Particles, Effects, Game) plus the graduated MonoGame-free
         foundation (Ecs/Serialization/Content/Diagnostics/App/Localization/Persistence/Pooling/Platform/Updates/
         Collision/Netcode/Netcode.Abstractions/Netcode.LiteNetLib). Bump here to release them together; this is
         the version the doc-version guard checks. -->
    <KhaozEngine5xVersion>7.45.0</KhaozEngine5xVersion>
    <Authors>APKiwi</Authors>
    <Company>Khaoz</Company>
    <PackageProjectUrl>https://github.com/APKiwi/KhaozEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/APKiwi/KhaozEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 APKiwi. All rights reserved.</Copyright>

    <!-- SourceLink + symbols so games keep step-into-source debugging. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Ship XML doc comments in the packages for IntelliSense. 1591 = "missing doc
         on public member": suppressed so partial coverage doesn't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
