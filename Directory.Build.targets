<Project>
  <!-- Relativize the source/PDB paths embedded in packed (Release) DLLs so no absolute build-box
       home path (e.g. /Users/&lt;name&gt;/KhaozEngine/...) ships in the shipped DLL's PE debug directory,
       regardless of which machine packs the release. The embedded path is recoverable via `strings`
       even though PDBs themselves ship only in the .snupkg (never pushed), so this closes the residual
       leak. ContinuousIntegrationBuild turns on deterministic builds + the well-known source-root
       pathmap, rewriting absolute paths to /_/-style.

       Scoped to PACKABLE Release builds:
         * Release because `dotnet pack` always runs -c Release, so every shipped package is covered
           while local Debug builds keep real paths for step-into.
         * IsPackable != false because the pathmap also rewrites [CallerFilePath], which the test and
           sample projects use to locate the repo tree at runtime (CetCompatDefaultTests, GoldenCompare).
           Those projects are never shipped, so they must keep real source paths. This lives in
           Directory.Build.targets (imported AFTER the csproj body) precisely so IsPackable - set in the
           project body - is visible; in Directory.Build.props it would not be.
       Respects an explicit ContinuousIntegrationBuild override (CI may set it true itself).

       DeterministicSourcePaths is set explicitly here, not left to the SDK default. The SDK defaults
       it from ContinuousIntegrationBuild inside Sdk.targets, which is imported BEFORE this file - so by
       the time we flip ContinuousIntegrationBuild on, that default has already evaluated to empty and no
       pathmap is built (paths would stay absolute). DeterministicSourcePaths is what actually drives the
       source-root pathmap, so we turn it on directly. SourceLink (referenced by every packable project)
       populates the SourceRoot the pathmap needs. -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and '$(Configuration)' == 'Release' and '$(IsPackable)' != 'false'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DeterministicSourcePaths Condition="'$(DeterministicSourcePaths)' == ''">true</DeterministicSourcePaths>
  </PropertyGroup>

  <!-- THE LINUX NATIVE LOAD PATH. Silk.NET does not use [DllImport] for these bindings, so the .NET host's own
       deps.json resolution never runs: Silk.NET.Core's DefaultPathResolver does the work, and it asks
       Microsoft.DotNet.PlatformAbstractions for the current runtime identifier and then probes
       runtimes/<rid>/native under the app base. On Linux that call answers with the DISTRO rid
       (ubuntu.24.04-x64 on the CI runner and in a stock ubuntu container), never the portable linux-x64 the
       packages actually ship under, and neither bridge between the two is left standing: deps.json has carried
       no rid fallback graph since .NET 8, and the resolver's hand-rolled guess only understands rids that start
       with osx or win. macOS and Windows therefore resolve out of runtimes/ and Linux cannot, which is how
       18.0.0's shaderc front end threw "Could not load from any of the possible library names" on every Linux
       test that compiles a shader (#691), while the Metal and D3D11 legs loaded the same package fine.

       The resolver's FIRST probe is the app base directory itself, so one flat copy of the host rid's native
       assets next to the assemblies fixes every binding at once: shaderc, SPIRV-Cross, GLFW, OpenAL Soft.
       Linux only, because the other two platforms already work and the copy is about 13 MB per project.
       Build-time, because CI builds once and then runs every test leg against that output without rebuilding. -->
  <Target Name="KhaozEngineCopyHostNativesToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$([MSBuild]::IsOSPlatform(Linux))' == 'true' and '$(NETCoreSdkPortableRuntimeIdentifier)' != ''">
    <ItemGroup>
      <_KhaozEngineHostNative Include="@(RuntimeTargetsCopyLocalItems)"
                              Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(NETCoreSdkPortableRuntimeIdentifier)'" />
    </ItemGroup>
    <Copy SourceFiles="@(_KhaozEngineHostNative)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          UseHardlinksIfPossible="true" />
  </Target>
</Project>
