<Project>
  <!-- Central package management: every external package version is pinned HERE, once.
       csprojs carry only <PackageReference Include="..."/> with no Version attribute.
       Added in 9.0.0 after Silk.NET drifted apart (Windowing 2.22.0 vs Audio 2.23.0). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- GPU / windowing / render stack -->
    <PackageVersion Include="Veldrid" Version="4.9.0" />
    <PackageVersion Include="Veldrid.SPIRV" Version="1.0.15" />
    <!-- CVE override: Veldrid.SPIRV drags in vulnerable Newtonsoft.Json 9.0.1 (NU1903). Not used directly. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Input" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageVersion Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageVersion Include="StbImageSharp" Version="2.30.15" />
    <PackageVersion Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageVersion Include="SharpGLTF.Toolkit" Version="1.0.6" />

    <!-- Audio -->
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <!-- OpenAL Soft natives version their own line (not Silk.NET 2.x). -->
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="NLayer" Version="1.16.0" />

    <!-- Foundation / content / physics -->
    <PackageVersion Include="JsonSchema.Net" Version="9.1.3" />
    <PackageVersion Include="BepuPhysics" Version="2.4.0" />

    <!-- Netcode / stores -->
    <PackageVersion Include="LiteNetLib" Version="2.1.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />

    <!-- Packaging / tests / tools -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>
</Project>
