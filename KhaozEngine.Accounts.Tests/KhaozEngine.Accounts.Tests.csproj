<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <!-- Pinned so the declared namespaces stay KhaozEngine.Tests.Accounts.*, per AGENTS.md. -->
    <RootNamespace>KhaozEngine.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- The seam, the reference store and the ban adapter. The durable backends' conformance legs join this
         project beside InMemoryAccountStoreConformanceTests, each adding its own backend reference, so the one
         suite runs against every store unchanged. -->
    <ProjectReference Include="../KhaozEngine.Accounts/KhaozEngine.Accounts.csproj" />
    <!-- The SQLite backend's conformance legs and its Grimhollow layout fixtures. The fixtures build legacy
         tables with the driver the backend already brings. -->
    <ProjectReference Include="../KhaozEngine.Accounts.Sqlite/KhaozEngine.Accounts.Sqlite.csproj" />
    <!-- The SQL Server backend's leg. Its construction facts run everywhere, and its conformance and layout facts
         skip unless KE_ACCOUNTS_SQLSERVER names a test database, which CI's accounts-sqlserver job provides. -->
    <ProjectReference Include="../KhaozEngine.Accounts.SqlServer/KhaozEngine.Accounts.SqlServer.csproj" />
    <!-- For one fact only: AccountStoreRules.ReservedSubjectPrefix restates PositionHintCache.GuestAccountPrefix,
         which Accounts cannot reference, and this is the project that sees both. WorldStore is dependency-free. -->
    <ProjectReference Include="../KhaozEngine.WorldStore/KhaozEngine.WorldStore.csproj" />
  </ItemGroup>
</Project>
