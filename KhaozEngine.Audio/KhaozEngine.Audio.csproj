<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Audio</PackageId>
    <!-- Graduated to the shared 5.x experimental custom-stack line (was 4.x MonoGame). -->
    <Version>$(KhaozEngine5xVersion)</Version>
    <Description>EXPERIMENTAL game-agnostic background-music backend on the custom MonoGame-free stack: an OpenAL (Silk.NET.OpenAL) streaming music backend behind the IMusicBackend seam, decoding WAV / OGG (NVorbis) / MP3 (NLayer), with a caller-registered track list, volume, enable, and automatic track rotation (AudioSystem). No MonoGame. Part of the post-MonoGame 5.x line.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="NLayer" Version="1.16.0" />
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
