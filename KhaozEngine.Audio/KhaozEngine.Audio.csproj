<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Audio</PackageId>
    <!-- Graduated to the shared 5.x experimental custom-stack line (was 4.x MonoGame). -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>game-agnostic audio on the custom MonoGame-free stack: an OpenAL (Silk.NET.OpenAL) streaming music backend behind the IMusicBackend seam, plus one-shot SFX with optional 3D positional audio (ISfxBackend, per-sound position + listener) and a placeholder WAV synth, decoding WAV / OGG (NVorbis) / MP3 (NLayer), with caller-registered track / SFX lists, volume, enable, and automatic track rotation (AudioSystem). No MonoGame. Part of the post-MonoGame 5.x line.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" />
    <!-- Bundle openal-soft as RID-specific natives so consumers don't depend on the deprecated macOS system
         OpenAL.framework (or a manually-installed lib). Flows to the consuming app's output via the runtime graph. -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="NLayer" />
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <InternalsVisibleTo Include="KhaozEngine.Audio.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- THE LINUX HOST-NATIVE FLATTEN, shipped by this package as well as by KhaozEngine.Foundation
       (https://github.com/APKiwiOrg/KhaozEngine/issues/723). This package carries Silk.NET natives, so a
       consumer that references it on its own and takes no umbrella needs the rule, and Foundation is not in
       its dependency closure. The file is the ONE copy under KhaozEngine.Foundation/build, packed here under
       this package's own PackageId so NuGet auto-imports it with no Import line: only <PackageId>.props and
       <PackageId>.targets are picked up automatically. A consumer that takes both this and an umbrella lands
       two copies, which is an override rather than an error, because the two are the same bytes. No
       PrivateAssets moved anywhere, so asset flow is unchanged. -->
  <ItemGroup>
    <None Include="../KhaozEngine.Foundation/build/KhaozEngine.HostNatives.targets" Pack="true" PackagePath="build/KhaozEngine.Audio.targets" />
    <None Include="../KhaozEngine.Foundation/build/KhaozEngine.HostNatives.targets" Pack="true" PackagePath="buildTransitive/KhaozEngine.Audio.targets" />
  </ItemGroup>
</Project>
