<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Measurement tool, never packed or on the version line. Default engine CI retains structural
         and instrument checks in Server.Tests. The outside-solution Items.Benchmark.Tests quick run
         gates explicit benchmark validation before evidence publication, not engine CI timing. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The real server-tick path being measured: ShardHost (Sharding) -> CellSim -> FixedTickHost (Simulation)
         -> World.Update (Ecs). Replication is a ShardHost ctor dependency; Primitives gives the seeded RNG. -->
    <ProjectReference Include="../KhaozEngine.Ecs/KhaozEngine.Ecs.csproj" />
    <ProjectReference Include="../KhaozEngine.Simulation/KhaozEngine.Simulation.csproj" />
    <ProjectReference Include="../KhaozEngine.Sharding/KhaozEngine.Sharding.csproj" />
    <ProjectReference Include="../KhaozEngine.Replication/KhaozEngine.Replication.csproj" />
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <ProjectReference Include="../KhaozEngine.WorldStore/KhaozEngine.WorldStore.csproj" />
    <ProjectReference Include="../KhaozEngine.WorldStore.Sqlite/KhaozEngine.WorldStore.Sqlite.csproj" />
    <ProjectReference Include="../KhaozEngine.WorldStore.SqlServer/KhaozEngine.WorldStore.SqlServer.csproj" />
    <!-- The catalog crash probe mode drives the REAL authoring stack: the SQLite provider, the publish
         commit and a FileSystemPackStore, so a killed child leaves state the harness reopens and checks.
         The catalog benchmark mode beside it measures a synthetic prototype and takes none of these. -->
    <ProjectReference Include="../KhaozEngine.Catalog/KhaozEngine.Catalog.csproj" />
    <ProjectReference Include="../KhaozEngine.Catalog.Authoring/KhaozEngine.Catalog.Authoring.csproj" />
    <ProjectReference Include="../KhaozEngine.Catalog.Sqlite/KhaozEngine.Catalog.Sqlite.csproj" />
    <!-- The item-instances mode measures the SHIPPED generator: its rows go through ContentSnapshotBuilder,
         budget 9 times ModCandidateTables.Build over them and every roll goes through ItemGenerator. -->
    <ProjectReference Include="../KhaozEngine.ItemInstances/KhaozEngine.ItemInstances.csproj" />
    <!-- The jpeg mode times the shipped JpegWriter on one bug report clip frame. -->
    <ProjectReference Include="../KhaozEngine.Imaging/KhaozEngine.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ResidentMemory is the instrument every memory budget is read through, so its own accuracy is a fact
         the CI suite pins rather than something only a hand-run benchmark would notice. See
         KhaozEngine.Server.Tests/Benchmarks/ResidentMemoryTests.cs. -->
    <InternalsVisibleTo Include="KhaozEngine.Server.Tests" />
    <InternalsVisibleTo Include="Items.Benchmark.Tests" />
  </ItemGroup>
</Project>
