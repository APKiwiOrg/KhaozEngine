<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.BugReports</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>The headless in-game bug report model for KhaozEngine (opt-in, NOT in any umbrella). Holds the report media records a client capture returns: ReportImage for a screenshot and ReportClip with its ReportClipFrame list for the rolling clip. Pure .NET, no GPU, window or game dependency, so a server can reference it.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
