<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>KhaozEngine.Catalog.SqlServer</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>SQL Server / Azure SQL IContentAuthoringStore backend for the content catalog over Microsoft.Data.SqlClient: SqlServerContentAuthoringStore persists the fifteen catalog tables (metadata, types, versions, temporal rows and their field values, families and their aligned id blocks, the id high-water marks, the one draft and its edits, the field-level audit, the append-only remap rules, the per-side chunk rows and the content upgrade ledger) behind a fresh pooled connection per call, with a versioned embedded schema that either auto-creates or validates. Raw parameterized async ADO.NET with @name parameters, no EF and no ORM, every key column pinned to Latin1_General_100_BIN2, and one Serializable transaction per publish, so two consoles publishing at once are a refusal rather than a race. The production and shared-authoring store; same contract as the SQLite backend. Opt-in: in NO umbrella, pulls Microsoft.Data.SqlClient, and a game client never links it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <ProjectReference Include="../KhaozEngine.Catalog.Authoring/KhaozEngine.Catalog.Authoring.csproj" />
    <!-- Every version ships: V4 is what a fresh create runs, and V1 to V3 are the operator's record of the
         shapes the migrations move and what the migration tests build older databases from. Same set
         KhaozEngine.WorldStore.SqlServer ships for the journal. -->
    <EmbeddedResource Include="CatalogSchemaV1.sql" />
    <EmbeddedResource Include="CatalogSchemaV2.sql" />
    <EmbeddedResource Include="CatalogSchemaV3.sql" />
    <EmbeddedResource Include="CatalogSchemaV4.sql" />
    <!-- SqlServerCatalogSchemaDriftTests reads the embedded version 4 DDL and the transcribed expectation
         sets and asserts they name the same objects, and SqlServerCatalogRowTimestampScriptTests and
         SqlServerTextSchemaMigrationTests pin the row time columns and the version 4 additions of every
         script the same way, which are the SQL Server schema checks that need no instance (issue 922). Same
         grant KhaozEngine.WorldStore.SqlServer already makes. -->
    <InternalsVisibleTo Include="KhaozEngine.Server.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
