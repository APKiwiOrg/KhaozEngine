<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>KhaozEngine.Catalog.SqlServer</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>SQL Server / Azure SQL IContentAuthoringStore backend for the content catalog over Microsoft.Data.SqlClient: SqlServerContentAuthoringStore persists the fourteen catalog tables (metadata, types, versions, temporal rows and their field values, families and their aligned id blocks, the id high-water marks, the one draft and its edits, the field-level audit, the append-only remap rules and the per-side chunk rows) behind a fresh pooled connection per call, with a versioned embedded schema that either auto-creates or validates. Raw parameterized async ADO.NET with @name parameters, no EF and no ORM, every key column pinned to Latin1_General_100_BIN2, and one Serializable transaction per publish, so two consoles publishing at once are a refusal rather than a race. The production and shared-authoring store; same contract as the SQLite backend. Opt-in: in NO umbrella, pulls Microsoft.Data.SqlClient, and a game client never links it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <ProjectReference Include="../KhaozEngine.Catalog.Authoring/KhaozEngine.Catalog.Authoring.csproj" />
    <EmbeddedResource Include="CatalogSchemaV1.sql" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
