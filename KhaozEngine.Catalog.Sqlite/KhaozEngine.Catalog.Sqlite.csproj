<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>KhaozEngine.Catalog.Sqlite</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>SQLite IContentAuthoringStore backend for the content catalog over Microsoft.Data.Sqlite: SqliteContentAuthoringStore persists the fifteen catalog tables (metadata, types, versions, temporal rows and their field values, families and their aligned id blocks, the id high-water marks, the one draft and its edits, the field-level audit, the append-only remap rules, the per-side chunk rows and the content upgrade ledger) behind one held connection with a versioned schema that either auto-creates or validates. Raw parameterized async ADO.NET with $name parameters, no EF and no ORM, foreign keys on, and one explicit transaction per publish. The zero-infra dev, test and single-node authoring store. Opt-in: in NO umbrella, pulls Microsoft.Data.Sqlite, and a game client never links it.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Override the bundled native SQLite binary to the patched build (SQLite 3.50.3, fixes
         CVE-2025-6965 / NU1903). Microsoft.Data.Sqlite 10.0.9 still pulls the vulnerable
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively; this direct ref upgrades ONLY the native
         lib (managed SQLitePCLRaw.core/provider stay at 2.1.11, the versions MDS is built against).
         Drop this pin once Microsoft.Data.Sqlite references a patched SQLitePCLRaw itself. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <ProjectReference Include="../KhaozEngine.Sqlite/KhaozEngine.Sqlite.csproj" />
    <ProjectReference Include="../KhaozEngine.Catalog.Authoring/KhaozEngine.Catalog.Authoring.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
