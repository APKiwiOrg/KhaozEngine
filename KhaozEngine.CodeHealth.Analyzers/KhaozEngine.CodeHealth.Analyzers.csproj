<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.CodeHealth.Analyzers</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <!-- Roslyn analyzers must target netstandard2.0 (overrides the repo-wide net10.0). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Analyzer assembly ships under analyzers/dotnet/cs (below), not lib/. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <DevelopmentDependency>false</DevelopmentDependency>
    <!-- RS2008 (analyzer release tracking) is overkill for this internal engine analyzer. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- This project cannot run the file-size analyzer on itself (self-reference). -->
    <KhaozSkipFileSizeAnalyzer>true</KhaozSkipFileSizeAnalyzer>
    <Description>Roslyn analyzers enforcing file-size and test-health ratchets at compile time. KESIZE001 freezes baselined file sizes and KESIZE002 caps unlisted files (default 800 lines, KhaozFileSizeCap overrides). KETEST001 counts exception-message wording assertions and KETEST002 counts non-public reflection access in xunit compilations. KETEST003 is a report-only review aid for possibly empty assertion loops. Enforced debt may shrink, never grow without owner approval. Ships buildTransitive props that discover .filesize-baseline and .testhealth-baseline independently. Each ratchet stays silent without its baseline. Flows to consumers via all four umbrellas.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <InternalsVisibleTo Include="KhaozEngine.CodeHealth.Analyzers.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive/KhaozEngine.CodeHealth.Analyzers.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
  <!-- Pack the built analyzer dll into the analyzers path so it runs in consuming projects. Runs during
       pack (after build), when the assembly exists, unlike a plain <None> glob evaluated pre-build. -->
  <Target Name="_AddAnalyzerToPackage">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).dll" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
