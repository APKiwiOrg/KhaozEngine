<Project>
  <!-- Zero-touch wiring for the file-size ratchet: find the consuming repo's .filesize-baseline by
       walking up from the project directory (repo root by convention) and hand it to the analyzer
       as an AdditionalFile. No baseline found means the repo has not adopted the ratchet and the
       analyzer stays silent, matching scripts/check-file-size.sh. Override the discovered directory
       with KhaozFileSizeBaselineDir if a repo keeps the baseline somewhere non-standard. -->
  <PropertyGroup>
    <KhaozFileSizeBaselineDir Condition="'$(KhaozFileSizeBaselineDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.filesize-baseline'))</KhaozFileSizeBaselineDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(KhaozFileSizeBaselineDir)' != ''">
    <AdditionalFiles Include="$(KhaozFileSizeBaselineDir)/.filesize-baseline" />
  </ItemGroup>
  <!-- Test-health adoption uses the same walked-up discovery and an independent override. -->
  <PropertyGroup>
    <KhaozTestHealthBaselineDir Condition="'$(KhaozTestHealthBaselineDir)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.testhealth-baseline'))</KhaozTestHealthBaselineDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(KhaozTestHealthBaselineDir)' != ''">
    <AdditionalFiles Include="$(KhaozTestHealthBaselineDir)/.testhealth-baseline" />
  </ItemGroup>
  <ItemGroup>
    <!-- Surfaces the cap override to the analyzer as build_property.KhaozFileSizeCap. -->
    <CompilerVisibleProperty Include="KhaozFileSizeCap" />
    <CompilerVisibleProperty Include="KhaozTestHealthMode" />
  </ItemGroup>
</Project>
