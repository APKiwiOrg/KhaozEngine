<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Content</PackageId>
    <!-- Graduated onto the shared 5.x line at 5.46.0 (was the 4.x <Version>); MonoGame-free foundation. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>Game-agnostic config loading (embedded/disk JSON) + JSON-schema validation, with build-time schema enforcement.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);BundleValidator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <ProjectReference Include="../KhaozEngine.Serialization/KhaozEngine.Serialization.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="build/KhaozEngine.Content.targets" Pack="true" PackagePath="build/KhaozEngine.Content.targets" />
    <None Include="build/KhaozEngine.Content.targets" Pack="true" PackagePath="buildTransitive/KhaozEngine.Content.targets" />
  </ItemGroup>

  <!-- Publish the console validator and bundle its output under tools/ in the nupkg, so the
       buildTransitive target can run it via `dotnet exec`. -->
  <Target Name="BundleValidator">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)../KhaozEngine.Content.Validator/KhaozEngine.Content.Validator.csproj&quot; -c $(Configuration) -o &quot;$(IntermediateOutputPath)validator&quot; --nologo" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(IntermediateOutputPath)validator/**/*">
        <PackagePath>tools/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
