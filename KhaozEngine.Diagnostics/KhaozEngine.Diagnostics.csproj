<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Diagnostics</PackageId>
    <!-- Graduated onto the shared 5.x line at 5.46.0 (was the 4.x <Version>); MonoGame-free foundation. -->
    <Version>$(KhaozEngineVersion)</Version>
    <!-- Multi-targeted below net10.0 because KhaozEngine.ServerStatus (which references this package)
         must be consumable from an Azure Functions app on the Linux Consumption (Y1) plan, and that
         plan's newest supported LTS is .NET 8, not .NET 10. See the ServerStatus csproj for the full
         rationale. Blanks the single <TargetFramework> from Directory.Build.props and sets the plural
         set instead. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Game-agnostic logging service: levels, pluggable sinks (rotating file / console / debug / in-memory), category loggers, a static Log facade over an injectable LogManager, non-blocking background writes, and crash hooks. Pure .NET, no MonoGame dependency.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Tests" />
    <InternalsVisibleTo Include="KhaozEngine.Foundation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
