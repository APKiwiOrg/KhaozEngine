<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Diagnostics</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <!-- Multi-targeted below net10.0 because KhaozEngine.ServerStatus (which references this package)
         must be consumable from an Azure Functions app on the Linux Consumption (Y1) plan, and that
         plan's newest supported LTS is .NET 8, not .NET 10. See the ServerStatus csproj for the full
         rationale. Blanks the single <TargetFramework> from Directory.Build.props and sets the plural
         set instead. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Game-agnostic logging service: levels, pluggable sinks (rotating file / console / debug / in-memory), category loggers, a static Log facade over an injectable LogManager, non-blocking background writes, and crash hooks. Pure .NET.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- These facades share the internal async-flow slot without exposing a generic public helper. -->
    <InternalsVisibleTo Include="KhaozEngine.App" />
    <InternalsVisibleTo Include="KhaozEngine.Gui" />
    <InternalsVisibleTo Include="KhaozEngine.Foundation.Tests" />
    <!-- GameApp's arming decision is tested where GameApp lives, and driving the ARMED path (rather than a
         plain Write) is what proves a head's own Install survived. CrashReport.OnCrash is that seam. -->
    <InternalsVisibleTo Include="KhaozEngine.Game.Tests" />
    <!-- Capacity demand provenance stays engine-internal. Only the assemblies that derive limit copies may record origins,
         so no caller can attach provenance to engine-held records. See docs/DEPENDENCY-SEAMS.md. -->
    <InternalsVisibleTo Include="KhaozEngine.MapDoc" />
    <InternalsVisibleTo Include="KhaozEngine.MapDoc.Render3D" />
    <!-- Derived-origin rows build their synthetic provenance through MapDoc's internal origin helpers. -->
    <InternalsVisibleTo Include="KhaozEngine.MapDoc.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
