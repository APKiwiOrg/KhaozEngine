<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Ecs</PackageId>
    <Description>Game-agnostic struct-based archetype ECS: versioned entities, ref access, ForEach queries, command buffer, resources, systems.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- MonoGame-free: the ECS source uses no Xna types, so the custom 5.x stack can reuse it. Its only dep,
         KhaozEngine.Serialization, is pure BCL. -->
    <ProjectReference Include="../KhaozEngine.Serialization/KhaozEngine.Serialization.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
