<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Foundation</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Umbrella metapackage for the MonoGame-free, GPU-free foundation: Primitives, App, Content, Determinism, Diagnostics, Dungeon, Ecs, Http, Identity, Locomotion, MapDoc, Navigation, Objectives, Persistence, Physics, Progression, Serialization, ServerStatus, Social, Collision, Platform, Terrain, TileWorld, TileWorld.Editing, Updates, Stats. One reference for a gameplay-logic library or any non-rendering project that wants the engine's shared building blocks without pulling Windowing/Render/Gui/Audio or any GPU. (Networking lives in KhaozEngine.Netcode*, the game-runtime bundles are KhaozEngine.Game2D/Game3D, and a headless server is KhaozEngine.Server.) Contains no code, just dependencies.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <!-- NU5128: this is a dependency-only umbrella metapackage (IncludeBuildOutput=false, no lib/
         content of its own) whose only content is the ProjectReference set above; NuGet warns that
         the package has dependencies but no lib assets for any TFM, which is expected here. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Code-free dependency group: the packed reference below carries the analyzer to consumers, and
         the repo-wide Analyzer-typed dogfood reference would duplicate it. -->
    <KhaozSkipFileSizeAnalyzer>true</KhaozSkipFileSizeAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.App/KhaozEngine.App.csproj" />
    <ProjectReference Include="../KhaozEngine.Collision/KhaozEngine.Collision.csproj" />
    <ProjectReference Include="../KhaozEngine.Content/KhaozEngine.Content.csproj" />
    <ProjectReference Include="../KhaozEngine.Determinism/KhaozEngine.Determinism.csproj" />
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <ProjectReference Include="../KhaozEngine.Dungeon/KhaozEngine.Dungeon.csproj" />
    <ProjectReference Include="../KhaozEngine.Ecs/KhaozEngine.Ecs.csproj" />
    <ProjectReference Include="../KhaozEngine.Http/KhaozEngine.Http.csproj" />
    <ProjectReference Include="../KhaozEngine.Identity/KhaozEngine.Identity.csproj" />
    <ProjectReference Include="../KhaozEngine.Locomotion/KhaozEngine.Locomotion.csproj" />
    <ProjectReference Include="../KhaozEngine.MapDoc/KhaozEngine.MapDoc.csproj" />
    <ProjectReference Include="../KhaozEngine.Navigation/KhaozEngine.Navigation.csproj" />
    <ProjectReference Include="../KhaozEngine.Objectives/KhaozEngine.Objectives.csproj" />
    <ProjectReference Include="../KhaozEngine.Persistence/KhaozEngine.Persistence.csproj" />
    <ProjectReference Include="../KhaozEngine.Physics/KhaozEngine.Physics.csproj" />
    <ProjectReference Include="../KhaozEngine.Platform/KhaozEngine.Platform.csproj" />
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <ProjectReference Include="../KhaozEngine.Progression/KhaozEngine.Progression.csproj" />
    <ProjectReference Include="../KhaozEngine.Serialization/KhaozEngine.Serialization.csproj" />
    <ProjectReference Include="../KhaozEngine.ServerStatus/KhaozEngine.ServerStatus.csproj" />
    <ProjectReference Include="../KhaozEngine.Social/KhaozEngine.Social.csproj" />
    <ProjectReference Include="../KhaozEngine.Stats/KhaozEngine.Stats.csproj" />
    <ProjectReference Include="../KhaozEngine.Terrain/KhaozEngine.Terrain.csproj" />
    <ProjectReference Include="../KhaozEngine.TileWorld/KhaozEngine.TileWorld.csproj" />
    <ProjectReference Include="../KhaozEngine.TileWorld.Editing/KhaozEngine.TileWorld.Editing.csproj" />
    <ProjectReference Include="../KhaozEngine.Updates/KhaozEngine.Updates.csproj" />
    <!-- File-size ratchet analyzer: packs as a dependency so it flows to any consumer of this umbrella.
         PrivateAssets="none" keeps the Analyzers+Build assets in the packed dependency (the
         ProjectReference default excludes them), so the analyzer and its buildTransitive baseline
         discovery actually apply in the consumer's build. All four umbrellas carry it, unlike the
         localization analyzer: the ratchet applies to server and foundation code too. -->
    <ProjectReference Include="../KhaozEngine.CodeHealth.Analyzers/KhaozEngine.CodeHealth.Analyzers.csproj"
                      PrivateAssets="none" />
  </ItemGroup>
  <!-- Ship the game-head build defaults (CETCompat=false, overridable) so every consuming
       head inherits the standard. buildTransitive/ makes it flow whether Foundation is a
       direct reference (Server, gameplay-logic libs) or pulled in via Game2D/Game3D. -->
  <ItemGroup>
    <None Include="build/KhaozEngine.Foundation.props" Pack="true" PackagePath="build/KhaozEngine.Foundation.props" />
    <None Include="build/KhaozEngine.Foundation.props" Pack="true" PackagePath="buildTransitive/KhaozEngine.Foundation.props" />
    <None Include="build/KhaozEngine.Foundation.targets" Pack="true" PackagePath="build/KhaozEngine.Foundation.targets" />
    <None Include="build/KhaozEngine.Foundation.targets" Pack="true" PackagePath="buildTransitive/KhaozEngine.Foundation.targets" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
