<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Foundation</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Umbrella metapackage for the MonoGame-free, GPU-free foundation: Primitives, App, Content, Determinism, Diagnostics, Ecs, Locomotion, Persistence, Physics, Progression, Serialization, Social, Collision, Platform, Terrain, Updates. One reference for a gameplay-logic library or any non-rendering project that wants the engine's shared building blocks without pulling Windowing/Render/Gui/Audio or any GPU. (Networking lives in KhaozEngine.Netcode*; the game-runtime bundles are KhaozEngine.Game2D/Game3D; a headless server is KhaozEngine.Server.) Contains no code; just dependencies.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.App/KhaozEngine.App.csproj" />
    <ProjectReference Include="../KhaozEngine.Collision/KhaozEngine.Collision.csproj" />
    <ProjectReference Include="../KhaozEngine.Content/KhaozEngine.Content.csproj" />
    <ProjectReference Include="../KhaozEngine.Determinism/KhaozEngine.Determinism.csproj" />
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <ProjectReference Include="../KhaozEngine.Ecs/KhaozEngine.Ecs.csproj" />
    <ProjectReference Include="../KhaozEngine.Locomotion/KhaozEngine.Locomotion.csproj" />
    <ProjectReference Include="../KhaozEngine.Persistence/KhaozEngine.Persistence.csproj" />
    <ProjectReference Include="../KhaozEngine.Physics/KhaozEngine.Physics.csproj" />
    <ProjectReference Include="../KhaozEngine.Platform/KhaozEngine.Platform.csproj" />
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <ProjectReference Include="../KhaozEngine.Progression/KhaozEngine.Progression.csproj" />
    <ProjectReference Include="../KhaozEngine.Serialization/KhaozEngine.Serialization.csproj" />
    <ProjectReference Include="../KhaozEngine.Social/KhaozEngine.Social.csproj" />
    <ProjectReference Include="../KhaozEngine.Terrain/KhaozEngine.Terrain.csproj" />
    <ProjectReference Include="../KhaozEngine.Updates/KhaozEngine.Updates.csproj" />
  </ItemGroup>
  <!-- Ship the game-head build defaults (CETCompat=false, overridable) so every consuming
       head inherits the standard. buildTransitive/ makes it flow whether Foundation is a
       direct reference (Server, gameplay-logic libs) or pulled in via Game2D/Game3D. -->
  <ItemGroup>
    <None Include="build/KhaozEngine.Foundation.props" Pack="true" PackagePath="build/KhaozEngine.Foundation.props" />
    <None Include="build/KhaozEngine.Foundation.props" Pack="true" PackagePath="buildTransitive/KhaozEngine.Foundation.props" />
    <None Include="build/KhaozEngine.Foundation.targets" Pack="true" PackagePath="build/KhaozEngine.Foundation.targets" />
    <None Include="build/KhaozEngine.Foundation.targets" Pack="true" PackagePath="buildTransitive/KhaozEngine.Foundation.targets" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
