<Project>
  <!-- THE LINUX NATIVE LOAD PATH, shipped to consumers.

       Silk.NET does not use [DllImport] for its bindings, so the .NET host's own deps.json native
       resolution never runs. Silk.NET.Core's DefaultPathResolver does the work instead: it asks
       Microsoft.DotNet.PlatformAbstractions for the current runtime identifier and then probes
       runtimes/<rid>/native under the app base. On Linux that identifier is the DISTRO rid
       (ubuntu.24.04-x64 in a stock ubuntu container and on a GitHub runner), never the portable
       linux-x64 the packages actually ship under, and both bridges between the two are gone:
       deps.json has carried no rid fallback graph since .NET 8, and the resolver's hand-rolled guess
       only understands rids beginning osx or win. macOS and Windows therefore resolve out of
       runtimes/ and Linux cannot.

       That hits every Silk.NET native the engine ships, not just one: shaderc and SPIRV-Cross
       (KhaozEngine.Gpu), GLFW (KhaozEngine.Windowing) and OpenAL Soft (KhaozEngine.Audio). A Linux
       app dies at the first call into any of them with "Could not load from any of the possible
       library names", most visibly out of SpirvFrontEnd's static constructor on the first shader
       compile. See https://github.com/APKiwiOrg/KhaozEngine/issues/722.

       The resolver's FIRST probe is the app base directory itself, so one flat copy of the host
       rid's native assets next to the assemblies fixes every binding at once. Linux only, because
       the other two platforms already resolve out of runtimes/ and the copy costs about 13 MB per
       project. Build-time, because a plain `dotnet build` followed by `dotnet run` or `dotnet test`
       is the shape that breaks. PUBLISH splits in two, measured rather than assumed: a
       `dotnet publish -r linux-x64` resolves the rid's assets flat and ships no runtimes/ folder at
       all, so there is nothing left to do, while a plain rid-agnostic `dotnet publish` keeps the
       runtimes/ tree and copies none of the build output's flat natives, so it needs the second
       target below.

       The copy is hardlinked and SkipUnchangedFiles, so a rebuild pays nothing. The filter is the
       host rid's native RuntimeTargetsCopyLocalItems rather than a list of file names, so a package
       that starts shipping another native is covered without editing this file, and a project that
       references no native package (a headless server on KhaozEngine.Server) matches nothing and the
       target is a no-op.

       Overridable: set <KhaozEngineFlattenHostNatives>false</KhaozEngineFlattenHostNatives> in your
       project to opt out. -->
  <PropertyGroup Condition="'$(KhaozEngineFlattenHostNatives)' == ''">
    <KhaozEngineFlattenHostNatives>true</KhaozEngineFlattenHostNatives>
  </PropertyGroup>

  <Target Name="KhaozEngineCopyHostNativesToOutput"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(KhaozEngineFlattenHostNatives)' == 'true' and '$([MSBuild]::IsOSPlatform(Linux))' == 'true' and '$(NETCoreSdkPortableRuntimeIdentifier)' != ''">
    <ItemGroup>
      <_KhaozEngineHostNative Include="@(RuntimeTargetsCopyLocalItems)"
                              Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(NETCoreSdkPortableRuntimeIdentifier)'" />
    </ItemGroup>
    <Copy SourceFiles="@(_KhaozEngineHostNative)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          UseHardlinksIfPossible="true" />
  </Target>

  <!-- The rid-agnostic publish half. `dotnet publish` with no -r republishes from the resolved package
       assets rather than from the build output, so the flat copies the target above made in $(OutDir)
       do not travel and the published app is broken again. Add the same host-rid natives to the
       publish set with a FLAT RelativePath. The runtimes/<rid>/native copies stay where they are
       rather than being replaced: the .NET host's own deps.json resolution understands the portable
       rid perfectly well and any [DllImport]-based native in the graph still resolves through it, so
       removing them to save the duplicate would trade this bug for a worse one. Skipped when a rid IS
       set, because the SDK already lays those flat and a second copy at the same relative path is a
       duplicate-file error. -->
  <Target Name="KhaozEngineFlattenHostNativesForPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(KhaozEngineFlattenHostNatives)' == 'true' and '$([MSBuild]::IsOSPlatform(Linux))' == 'true' and '$(NETCoreSdkPortableRuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(RuntimeTargetsCopyLocalItems)"
                             Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(NETCoreSdkPortableRuntimeIdentifier)'">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
