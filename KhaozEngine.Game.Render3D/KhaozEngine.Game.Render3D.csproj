<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Game.Render3D</PackageId>
    <Version>$(KhaozEngine5xVersion)</Version>
    <Description>3D integration for the KhaozEngine.Game loop/scene framework, kept separate so a 2D game (KhaozEngine.Game) pulls no 3D renderer. Adds GameApp3D (a GameApp that stands up a Render3DSurface and drives the 3D pass in the OnRenderWorld seam), the IGameScene3D scene hook (a GameScene that also submits a 3D world pass), and a SceneManager.Draw3D extension that draws the same visible scene set as Draw2D. Depends on KhaozEngine.Game + KhaozEngine.Render3D.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Game/KhaozEngine.Game.csproj" />
    <ProjectReference Include="../KhaozEngine.Locomotion/KhaozEngine.Locomotion.csproj" />
    <ProjectReference Include="../KhaozEngine.Render3D/KhaozEngine.Render3D.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
