<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- Applied before testhost starts. One cold and one warm operation do not reliably
           move runtime comparer initialization out of fixture witness comparison under tiering.
           Keep exact acquisition-through-disposal gates. Attribution is recorded in
           docs/verification/2026-10-12-support-gates-allocation.json. -->
      <DOTNET_TieredCompilation>0</DOTNET_TieredCompilation>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
