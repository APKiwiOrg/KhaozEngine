<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Game2D</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Umbrella metapackage for a desktop 2D game on the KhaozEngine 5.x stack: the 2D runtime (Windowing, Render2D, Gui, Audio, Particles, Telegraphs) + the Game loop/scene framework (GameApp/SceneManager, now Render3D-free) + the MonoGame-free Foundation. No 3D (Render3D) and no networking (Netcode) - reference KhaozEngine.Game3D for the full 3D stack, or add KhaozEngine.Netcode.LiteNetLib for 2D multiplayer. Contains no code; just dependencies.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2D runtime + the (now Render3D-free) game-loop framework -->
    <ProjectReference Include="../KhaozEngine.Windowing/KhaozEngine.Windowing.csproj" />
    <ProjectReference Include="../KhaozEngine.Render2D/KhaozEngine.Render2D.csproj" />
    <ProjectReference Include="../KhaozEngine.Gui/KhaozEngine.Gui.csproj" />
    <ProjectReference Include="../KhaozEngine.Audio/KhaozEngine.Audio.csproj" />
    <ProjectReference Include="../KhaozEngine.Particles/KhaozEngine.Particles.csproj" />
    <ProjectReference Include="../KhaozEngine.Telegraphs/KhaozEngine.Telegraphs.csproj" />
    <ProjectReference Include="../KhaozEngine.Game/KhaozEngine.Game.csproj" />
    <!-- shared MonoGame-free foundation -->
    <ProjectReference Include="../KhaozEngine.Foundation/KhaozEngine.Foundation.csproj" />
    <!-- Localization analyzer: packs as a dependency so it flows to any consumer of this umbrella (and,
         transitively, of Game3D, which references Game2D). PrivateAssets="none" keeps the Analyzers+Build
         assets in the packed dependency (the ProjectReference default excludes them), so the analyzer is
         actually applied in the consumer's build. -->
    <ProjectReference Include="../KhaozEngine.Localization.Analyzers/KhaozEngine.Localization.Analyzers.csproj"
                      PrivateAssets="none" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
