<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Game2D</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Desktop 2D game bundle with Windowing, Render2D, Gui, Audio, Particles, Telegraphs, the GameApp/SceneManager framework and Foundation. Includes the Metal, Direct3D 11 and Vulkan graphics backends with automatic platform registration, plus localization and code-health analyzers. Choose Game3D for 3D rendering, or add Netcode.LiteNetLib for multiplayer transport. Contains only dependencies.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Code-free dependency group: the packed reference below carries the analyzer to consumers, and
         the repo-wide Analyzer-typed dogfood reference would duplicate it. -->
    <KhaozSkipFileSizeAnalyzer>true</KhaozSkipFileSizeAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2D runtime + the (now Render3D-free) game-loop framework -->
    <ProjectReference Include="../KhaozEngine.Windowing/KhaozEngine.Windowing.csproj" />
    <!-- The three engine-owned native GPU backends. They stopped being opt-in in 18.0.0, when the Veldrid
         backend KhaozEngine.Gpu used to build itself was deleted: a seam with no built-in implementation left
         means an umbrella that carries Gpu without a backend carries a stack that cannot create a device.
         Declared here as well as ridden transitively through Windowing, so this file says out loud what the
         umbrella ships. Carrying all three (not just the build machine's) is what makes one package restore on
         every platform, and a foreign one is inert: each is platform-guarded, its interop sits behind NoInlining
         bodies the JIT never compiles off its platform, and only the running platform's is REGISTERED. -->
    <ProjectReference Include="../KhaozEngine.Gpu.Metal/KhaozEngine.Gpu.Metal.csproj" />
    <ProjectReference Include="../KhaozEngine.Gpu.D3D11/KhaozEngine.Gpu.D3D11.csproj" />
    <ProjectReference Include="../KhaozEngine.Gpu.Vulkan/KhaozEngine.Gpu.Vulkan.csproj" />
    <ProjectReference Include="../KhaozEngine.Render2D/KhaozEngine.Render2D.csproj" />
    <ProjectReference Include="../KhaozEngine.Gui/KhaozEngine.Gui.csproj" />
    <ProjectReference Include="../KhaozEngine.Audio/KhaozEngine.Audio.csproj" />
    <ProjectReference Include="../KhaozEngine.Particles/KhaozEngine.Particles.csproj" />
    <ProjectReference Include="../KhaozEngine.Telegraphs/KhaozEngine.Telegraphs.csproj" />
    <ProjectReference Include="../KhaozEngine.Game/KhaozEngine.Game.csproj" />
    <!-- shared foundation -->
    <!-- PrivateAssets keeps the BUILD asset flowing to the consumer (#722). The ProjectReference
         default is contentfiles;analyzers;build, which stamps exclude="Build,Analyzers" on the packed
         dependency, and that is what stopped Foundation's build/ files (the CETCompat and single-file
         defaults, and now the Linux host-native flatten) from ever reaching a head. Analyzers stay
         private here, they travel on their own include="All" dependencies below. -->
    <ProjectReference Include="../KhaozEngine.Foundation/KhaozEngine.Foundation.csproj"
                      PrivateAssets="contentfiles;analyzers" />
    <!-- Localization analyzer and StringId generator: pack as a dependency so both flow to any consumer of
         this umbrella and transitively to Game3D. PrivateAssets="none" keeps the Analyzers+Build assets in the
         packed dependency (the ProjectReference default excludes them), so the analyzer assembly and its
         buildTransitive AdditionalFiles metadata are applied in the consumer's build. -->
    <ProjectReference Include="../KhaozEngine.Localization.Analyzers/KhaozEngine.Localization.Analyzers.csproj"
                      PrivateAssets="none" />
    <!-- File-size ratchet analyzer: packs as a dependency so it flows to any consumer of this umbrella.
         PrivateAssets="none" keeps the Analyzers+Build assets in the packed dependency (the
         ProjectReference default excludes them), so the analyzer and its buildTransitive baseline
         discovery actually apply in the consumer's build. All four umbrellas carry it, unlike the
         localization analyzer: the ratchet applies to server and foundation code too. -->
    <ProjectReference Include="../KhaozEngine.CodeHealth.Analyzers/KhaozEngine.CodeHealth.Analyzers.csproj"
                      PrivateAssets="none" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
