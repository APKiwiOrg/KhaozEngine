<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Game3D</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Umbrella metapackage for a desktop 3D game on the KhaozEngine 5.x stack: a strict superset of KhaozEngine.Game2D plus Render3D and Game.Render3D (the 3D scene integration: GameApp3D, IGameScene3D, and the SceneManager.Draw3D extension), the Ground* telegraph extensions, Terrain.Render3D (the chunked-LOD terrain mesh builder over KhaozEngine.Terrain's analytic field), and TileWorld.Render3D (the ground mesher, prop path, region streaming and snapshot capture that render a KhaozEngine.TileWorld document). One reference gives the full 2D + 3D + game-loop stack. No networking (Netcode) - add KhaozEngine.Netcode.LiteNetLib if you need it. Contains no code; just dependencies.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Code-free dependency group: the packed reference below carries the analyzer to consumers, and
         the repo-wide Analyzer-typed dogfood reference would duplicate it. -->
    <KhaozSkipFileSizeAnalyzer>true</KhaozSkipFileSizeAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <!-- everything in the 2D bundle (Game is already there)... -->
    <!-- PrivateAssets keeps the BUILD asset flowing to the consumer (#722). The ProjectReference
         default is contentfiles;analyzers;build, which stamps exclude="Build,Analyzers" on the packed
         dependency, and that is what stopped Foundation's build/ files (the CETCompat and single-file
         defaults, and now the Linux host-native flatten) from ever reaching a head. Analyzers stay
         private here, they travel on their own include="All" dependencies below. -->
    <ProjectReference Include="../KhaozEngine.Game2D/KhaozEngine.Game2D.csproj"
                      PrivateAssets="contentfiles;analyzers" />
    <!-- ...plus the 3D renderer and the Game<->Render3D bridge -->
    <ProjectReference Include="../KhaozEngine.Render3D/KhaozEngine.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Game.Render3D/KhaozEngine.Game.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Telegraphs.Render3D/KhaozEngine.Telegraphs.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Terrain.Render3D/KhaozEngine.Terrain.Render3D.csproj" />
    <!-- the tile-world renderer: ground mesher, tile props, region streaming, snapshot capture -->
    <ProjectReference Include="../KhaozEngine.TileWorld.Render3D/KhaozEngine.TileWorld.Render3D.csproj" />
    <!-- the modern particle sim <-> Render3D adapter (looks, presets, light-linked draws) -->
    <ProjectReference Include="../KhaozEngine.Particles.Render3D/KhaozEngine.Particles.Render3D.csproj" />
    <!-- physics seam only; the BepuPhysics backend (KhaozEngine.Physics.Bepu) is an opt-in sibling
         package, not bundled here - matching the WorldStore.Sqlite/.SqlServer pattern -->
    <ProjectReference Include="../KhaozEngine.Physics/KhaozEngine.Physics.csproj" />
    <!-- File-size ratchet analyzer: packs as a dependency so it flows to any consumer of this umbrella.
         PrivateAssets="none" keeps the Analyzers+Build assets in the packed dependency (the
         ProjectReference default excludes them), so the analyzer and its buildTransitive baseline
         discovery actually apply in the consumer's build. All four umbrellas carry it, unlike the
         localization analyzer: the ratchet applies to server and foundation code too. -->
    <ProjectReference Include="../KhaozEngine.CodeHealth.Analyzers/KhaozEngine.CodeHealth.Analyzers.csproj"
                      PrivateAssets="none" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
