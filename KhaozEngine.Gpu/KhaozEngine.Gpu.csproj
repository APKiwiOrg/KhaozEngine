<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Gpu</PackageId>
    <!-- Shared engine version line: <KhaozEngineVersion> in Directory.Build.props. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>GPU backend seam for the custom MonoGame-free stack. Owns backend selection (GpuBackendSelector: RuntimeInformation probe, a stored GpuBackendKind? user preference passed in as data, and a KE_GRAPHICS_BACKEND override on top) and its provenance (GpuBackendSelection / GpuBackendSource record which of those decided, and keep the raw override value, so an unrecognized one is logged as a warning instead of silently reading as the OS default), the backend support probe and creation fallback (IsBackendSupported / SupportedBackends functionally probe what a settings UI may offer through each backend's own registered provider, and a failed device creation falls back to the platform default and reports FallbackAfterFailure with the backend that was requested, so a player cannot get stuck on a choice that will not start), the Direct3D11 driver-threading probe (GpuThreadingCaps / GpuThreadingDiagnostics: DriverCommandLists and DriverConcurrentCreates read off the live device and logged next to the backend line, with a WARN when the driver cannot build command lists and the D3D11 runtime is emulating them in software, and a hard no-op off Windows and off Direct3D11), GpuCapabilities (clip-space-Y / depth-range), and a GpuDeviceContext that resolves a backend, asks GpuBackendProviders for its registered IGpuBackendProvider and adopts the device that provider built. This package creates NO device of its own since 18.0.0, when the Veldrid incumbent backend was deleted: the three engine-owned native backends (KhaozEngine.Gpu.Metal / .Vulkan / .D3D11) are the only implementations, and the four Veldrid GpuBackendKind members are retired tokens that resolve to a named exception. Renderers consume the engine-owned IGpuDevice (GpuDevice). The SHADER TOOLCHAIN (Silk.NET.Shaderc plus Silk.NET.SPIRV.Cross) is the one third-party edge left here, and it is confined to this package.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <!-- Diagnostics is a dependency-free leaf, already carried by GPU-stack peers (Audio, Gui, Terrain). It is
         here so device creation can log which backend was selected and why. -->
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SHADER TOOLCHAIN, and the only package edge in the engine that reaches glslang or SPIRV-Cross.
         Silk.NET.Shaderc compiles GLSL 450 to SPIR-V (Internal/SpirvFrontEnd) and Silk.NET.SPIRV.Cross emits
         MSL and HLSL and hands back the reflection the backends bind against (Internal/SpirvCrossCompile,
         ShaderValidation). The two .Native packages carry the per-RID binaries, and Silk.NET.SPIRV carries the
         SPIR-V enums both bindings name in their signatures.
         ONE SEAT, decision P2: no backend package declares a toolchain reference of its own, and all three
         consume toolchain-free signatures across InternalsVisibleTo. That is what made row
         8's swap a change to one package instead of three. -->
    <PackageReference Include="Silk.NET.Shaderc" />
    <PackageReference Include="Silk.NET.Shaderc.Native" />
    <PackageReference Include="Silk.NET.SPIRV" />
    <PackageReference Include="Silk.NET.SPIRV.Cross" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" />
    <!-- The D3D11 binding, so the driver-threading probe (Internal/D3D11ThreadingProbe) can call
         ID3D11Device::CheckFeatureSupport on the raw device pointer the native Direct3D 11 backend hands it.
         Loaded only on Windows, only on Direct3D 11. -->
    <PackageReference Include="Vortice.Direct3D11" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Render.Tests" />
    <!-- The shared GPU test-support library, for ONE thing: the three uniform-ring adapters build their backend's
         ring, which since #531's counter extraction takes an Internal/WaitAccumulator, and read the stall count
         off an Internal/WaitTotals. Both are internal here, so the adapters cannot name them without this. It
         reads nothing else of this package's internals. -->
    <InternalsVisibleTo Include="KhaozEngine.TestSupport.Gpu" />
    <!-- The native Direct3D11 backend package (decision P2). It reads three internals of this package and
         nothing else: the toolchain-free SPIRV cross-compile helper (Internal/SpirvCrossCompile), which is what
         keeps the shader-toolchain package edge out of a backend that declares none of its own, IGpuDeviceLifecycle,
         the disposal hook a natively created device implements so it gets a liveness latch, and
         Internal/DeviceLiveness, which IS that latch: row 18 of the Metal design extracted the
         three per-backend copies into one shared token here (#531). All three are internal on purpose: none of
         them is API a consumer should see. -->
    <InternalsVisibleTo Include="KhaozEngine.Gpu.D3D11" />
    <!-- The native Vulkan backend package (decision V-P3). It reads the FRONT END of the shader toolchain
         (Internal/SpirvFrontEnd plus its pin), SpirvLocalSize, IGpuDeviceLifecycle and the shared
         Internal/DeviceLiveness latch (#531). It deliberately does NOT
         read Internal/SpirvCrossCompile: Vulkan consumes SPIR-V, so nothing on its shader path is cross-compiled,
         and decision V-S3 split the two halves apart so that stays true. VulkanShaderFrontEndOnlyTests asserts it
         over the built IL. -->
    <InternalsVisibleTo Include="KhaozEngine.Gpu.Vulkan" />
    <!-- The native Metal backend package (decision M-P2, M-S1). It reads BOTH halves of the shader toolchain,
         which is the Direct3D 11 shape rather than the Vulkan one: the front end (Internal/SpirvFrontEnd plus its
         pin) because its sources are GLSL, and Internal/SpirvCrossCompile's MSL half because Metal consumes MSL.
         It also reads SpirvResourceDecorations, which is the key its binding table joins on (section 2.2b), and
         SpirvLocalSize, IGpuDeviceLifecycle and the shared Internal/DeviceLiveness latch (#531) like its
         siblings. MetalShaderArchitectureTests asserts over the built IL that it names the MSL members and
         NEVER an HLSL one.
         It reads ONE thing no sibling does: Internal/MetalFrameCapture, plus GpuFrameCapture's internal
         arm-consume pair. That is decision M-G5 rather than an extra edge for convenience: the capture drives
         MTLCaptureManager through this package's own objc_msgSend declarations, and the backend owns its
         MTLCommandQueue, so it hands the pointer straight in. -->
    <InternalsVisibleTo Include="KhaozEngine.Gpu.Metal" />
  </ItemGroup>
</Project>
