<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Gpu</PackageId>
    <!-- Shared engine version line: <KhaozEngineVersion> in Directory.Build.props. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>GPU backend seam for the custom MonoGame-free stack. Owns backend selection (GpuBackendSelector: RuntimeInformation probe with a KE_GRAPHICS_BACKEND override), GpuCapabilities (clip-space-Y / depth-range), and a GpuDeviceContext that wraps Veldrid device creation (windowed via CreateForWindow from a native window handle, headless via GraphicsDevice.CreateMetal) so the 5.x renderers stop hard-coding GraphicsBackend.Metal. Renderers consume the engine-owned IGpuDevice (GpuDevice); the raw Veldrid device is a private implementation detail of the context. Veldrid deps are confined here.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Veldrid" />
    <PackageReference Include="Veldrid.SPIRV" />
    <!-- Override the vulnerable Newtonsoft.Json 9.0.1 that Veldrid.SPIRV drags in (NU1903). -->
    <PackageReference Include="Newtonsoft.Json" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Render.Tests" />
  </ItemGroup>
</Project>
