<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Gpu</PackageId>
    <!-- Shared engine version line: <KhaozEngineVersion> in Directory.Build.props. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>GPU backend seam for the custom MonoGame-free stack. Owns backend selection (GpuBackendSelector: RuntimeInformation probe, a stored GpuBackendKind? user preference passed in as data, and a KE_GRAPHICS_BACKEND override on top) and its provenance (GpuBackendSelection / GpuBackendSource record which of those decided, and keep the raw override value, so an unrecognized one is logged as a warning instead of silently reading as the OS default), the backend support probe and creation fallback (IsBackendSupported / SupportedBackends functionally probe what a settings UI may offer, and a failed device creation falls back to the OS-probe backend and reports FallbackAfterFailure with the backend that was requested, so a player cannot get stuck on a choice that will not start), the Direct3D11 driver-threading probe (GpuThreadingCaps / GpuThreadingDiagnostics: DriverCommandLists and DriverConcurrentCreates read off the live device and logged next to the backend line, with a WARN when the driver cannot build command lists and the D3D11 runtime is emulating them in software, and a hard no-op off Windows and off Direct3D11), GpuCapabilities (clip-space-Y / depth-range), and a GpuDeviceContext that wraps Veldrid device creation (windowed via CreateForWindow from a native window handle, headless via GraphicsDevice.CreateMetal) so the 5.x renderers stop hard-coding GraphicsBackend.Metal. Renderers consume the engine-owned IGpuDevice (GpuDevice). The raw Veldrid device is a private implementation detail of the context. Veldrid deps are confined here.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <!-- Diagnostics is a dependency-free leaf, already carried by GPU-stack peers (Audio, Gui, Terrain). It is
         here so device creation can log which backend was selected and why. -->
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Veldrid" />
    <PackageReference Include="Veldrid.SPIRV" />
    <!-- Veldrid's own D3D11 binding, already here transitively. Declared so the D3D11 driver-threading probe
         (Internal/D3D11ThreadingProbe) can call ID3D11Device::CheckFeatureSupport on the raw device pointer
         Veldrid publishes. Loaded only on Windows, only on the Direct3D11 backend. -->
    <PackageReference Include="Vortice.Direct3D11" />
    <!-- Override the vulnerable Newtonsoft.Json 9.0.1 that Veldrid.SPIRV drags in (NU1903). -->
    <PackageReference Include="Newtonsoft.Json" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Render.Tests" />
    <!-- The native Direct3D11 backend package (decision P2). It reads three internals of this package and
         nothing else: the Veldrid-free SPIRV cross-compile helper (Internal/SpirvCrossCompile), which is what
         keeps the Veldrid.SPIRV edge out of a backend whose premise is being Veldrid-free, IGpuDeviceLifecycle,
         the disposal hook a natively created device implements so it gets the same liveness latch the Veldrid
         wrapper has, and Internal/DeviceLiveness, which IS that latch: row 18 of the Metal design extracted the
         three per-backend copies into one shared token here (#531). All three are internal on purpose: none of
         them is API a consumer should see. -->
    <InternalsVisibleTo Include="KhaozEngine.Gpu.D3D11" />
    <!-- The native Vulkan backend package (decision V-P3). It reads the FRONT END of the shader toolchain
         (Internal/SpirvFrontEnd plus its pin), SpirvLocalSize, IGpuDeviceLifecycle and the shared
         Internal/DeviceLiveness latch (#531). It deliberately does NOT
         read Internal/SpirvCrossCompile: Vulkan consumes SPIR-V, so nothing on its shader path is cross-compiled,
         and decision V-S3 split the two halves apart so that stays true. VulkanShaderFrontEndOnlyTests asserts it
         over the built IL. -->
    <InternalsVisibleTo Include="KhaozEngine.Gpu.Vulkan" />
    <!-- The native Metal backend package (decision M-P2, M-S1). It reads BOTH halves of the shader toolchain,
         which is the Direct3D 11 shape rather than the Vulkan one: the front end (Internal/SpirvFrontEnd plus its
         pin) because its sources are GLSL, and Internal/SpirvCrossCompile's MSL half because Metal consumes MSL.
         It also reads SpirvResourceDecorations, which is the key its binding table joins on (section 2.2b), and
         SpirvLocalSize, IGpuDeviceLifecycle and the shared Internal/DeviceLiveness latch (#531) like its
         siblings. MetalShaderArchitectureTests asserts over the built IL that it names the MSL members and
         NEVER an HLSL one.
         It reads ONE thing no sibling does: Internal/MetalFrameCapture, plus GpuFrameCapture's internal
         arm-consume pair. That is decision M-G5 rather than an extra edge for convenience. The capture lives
         here because the Veldrid Metal path needs it too, and the native backend owns its MTLCommandQueue, so it
         hands the pointer in and the reflection into Veldrid's private _commandQueue field never runs on that
         path. Widening a backend-kind gate could not have achieved that: the gate sits inside the Veldrid device
         wrapper, which a provider-built device never becomes. -->
    <InternalsVisibleTo Include="KhaozEngine.Gpu.Metal" />
  </ItemGroup>
</Project>
