<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Gpu</PackageId>
    <!-- Shared engine version line: <KhaozEngineVersion> in Directory.Build.props. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>GPU backend seam for the custom MonoGame-free stack. Owns backend selection (GpuBackendSelector: RuntimeInformation probe with a KE_GRAPHICS_BACKEND override) and its provenance (GpuBackendSelection / GpuBackendSource record whether the OS probe or the override decided, and keep the raw override value, so an unrecognized one is logged as a warning instead of silently reading as the OS default), the Direct3D11 driver-threading probe (GpuThreadingCaps / GpuThreadingDiagnostics: DriverCommandLists and DriverConcurrentCreates read off the live device and logged next to the backend line, with a WARN when the driver cannot build command lists and the D3D11 runtime is emulating them in software, and a hard no-op off Windows and off Direct3D11), GpuCapabilities (clip-space-Y / depth-range), and a GpuDeviceContext that wraps Veldrid device creation (windowed via CreateForWindow from a native window handle, headless via GraphicsDevice.CreateMetal) so the 5.x renderers stop hard-coding GraphicsBackend.Metal. Renderers consume the engine-owned IGpuDevice (GpuDevice). The raw Veldrid device is a private implementation detail of the context. Veldrid deps are confined here.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <!-- Diagnostics is a dependency-free leaf, already carried by GPU-stack peers (Audio, Gui, Terrain). It is
         here so device creation can log which backend was selected and why. -->
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Veldrid" />
    <PackageReference Include="Veldrid.SPIRV" />
    <!-- Veldrid's own D3D11 binding, already here transitively. Declared so the D3D11 driver-threading probe
         (Internal/D3D11ThreadingProbe) can call ID3D11Device::CheckFeatureSupport on the raw device pointer
         Veldrid publishes. Loaded only on Windows, only on the Direct3D11 backend. -->
    <PackageReference Include="Vortice.Direct3D11" />
    <!-- Override the vulnerable Newtonsoft.Json 9.0.1 that Veldrid.SPIRV drags in (NU1903). -->
    <PackageReference Include="Newtonsoft.Json" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Render.Tests" />
  </ItemGroup>
</Project>
