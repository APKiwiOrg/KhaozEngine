<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Identity.Discord</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Discord provider + userinfo validator for KhaozEngine.Identity (auth-code + PKCE via the system browser + loopback, opaque-token OAuth2). Opt-in; not in any umbrella.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Identity/KhaozEngine.Identity.csproj" />
    <ProjectReference Include="../KhaozEngine.Platform/KhaozEngine.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="KhaozEngine.Tests" />
  </ItemGroup>
</Project>
