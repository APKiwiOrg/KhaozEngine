<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Imaging</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Dependency-free PNG I/O for KhaozEngine using BCL zlib. Includes RGBA8 encoding and noninterlaced 8/16-bit greyscale, GA, RGB and RGBA decoding.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Render.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
