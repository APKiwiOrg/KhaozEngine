{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaozengine.dev/schemas/mapdoc.schema.json",
  "title": "KhaozEngine zone map document",
  "type": "object",
  "required": ["formatVersion", "id", "bounds", "terrain"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "type": "integer", "const": 5 },
    "supportRecipe": { "type": "string", "enum": ["LegacyXzCallbackV1", "AuthoredBindingsV2"] },
    "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
    "surfacePatches": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/surfacePatch" } },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "tileSize": { "type": "number", "exclusiveMinimum": 0 },
    "bounds": {
      "type": "object",
      "required": ["minX", "minZ", "maxX", "maxZ"],
      "additionalProperties": false,
      "properties": {
        "minX": { "type": "number" },
        "minZ": { "type": "number" },
        "maxX": { "type": "number" },
        "maxZ": { "type": "number" }
      }
    },
    "playableBounds": {
      "type": ["object", "null"],
      "required": ["minX", "minZ", "maxX", "maxZ"],
      "additionalProperties": false,
      "properties": {
        "minX": { "type": "number" },
        "minZ": { "type": "number" },
        "maxX": { "type": "number" },
        "maxZ": { "type": "number" }
      }
    },
    "nativeAssets": { "type": "array", "items": { "$ref": "#/$defs/nativeAsset" } },
    "numericIdHighWaterMark": { "anyOf": [{ "const": "0" }, { "$ref": "#/$defs/positiveInt64Decimal" }], "description": "Nonnegative int64 decimal string, at most 9223372036854775807." },
    "resolverIdentity": {
      "type": ["object", "null"],
      "required": ["payloadVersion", "resolverVersion"],
      "additionalProperties": false,
      "properties": {
        "payloadVersion": { "type": "integer", "minimum": 1 },
        "resolverVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer" },
        "waterLevel": { "type": "number" },
        "biomeBlend": { "type": "number" },
        "gentleFrequency": { "type": "number" },
        "gentleAmplitude": { "type": "number" },
        "detailFrequency": { "type": "number" },
        "detailOctaves": { "type": "integer" },
        "biomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": { "type": ["number", "null"] },
              "end": { "type": ["number", "null"] },
              "biome": { "type": "string" },
              "baseHeight": { "type": "number" },
              "hillAmplitude": { "type": "number" }
            }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "scatterLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "cellSize": { "type": "number", "exclusiveMinimum": 0 },
          "jitter": { "type": "number" },
          "maxHeight": { "type": ["number", "null"] },
          "scaleMin": { "type": "number" },
          "scaleMax": { "type": "number" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "biome": { "type": "string" },
                "density": { "type": "number", "minimum": 0, "maximum": 1 },
                "kinds": { "$ref": "#/$defs/kinds" }
              }
            }
          }
        }
      }
    },
    "companionLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "hostLayer"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "hostLayer": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "hostKinds": { "type": "array", "items": { "type": "string" } },
          "kinds": { "$ref": "#/$defs/kinds" },
          "countMin": { "type": "integer", "minimum": 0 },
          "countMax": { "type": "integer", "minimum": 0 },
          "radiusMin": { "type": "number" },
          "radiusMax": { "type": "number" },
          "scaleMin": { "type": "number" },
          "scaleMax": { "type": "number" },
          "maxHeight": { "type": ["number", "null"] }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "shape": { "$ref": "#/$defs/shape" },
          "layers": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      }
    },
    "scatterOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "shape": { "$ref": "#/$defs/shape" },
          "densityMultiplier": { "type": "number", "minimum": 0 },
          "kinds": { "anyOf": [ { "$ref": "#/$defs/kinds" }, { "type": "null" } ] },
          "layers": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      }
    },
    "placements": { "$ref": "#/$defs/placements" },
    "spawns": { "$ref": "#/$defs/spawns" },
    "playerSpawns": { "$ref": "#/$defs/playerSpawns" },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "shape": { "$ref": "#/$defs/shape" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "terrainOverrides": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cellSize", "tiles"],
          "properties": {
            "cellSize": { "type": "number", "exclusiveMinimum": 0 },
            "tiles": { "$ref": "#/$defs/sculptTiles" }
          }
        }
      ]
    }
  },
  "$defs": {
    "surfaceSlotRect": {"type":"object","required":["minX","minZ","maxXExclusive","maxZExclusive"],"additionalProperties":false,"properties":{"minX":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807},"minZ":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807},"maxXExclusive":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807},"maxZExclusive":{"type":"integer","minimum":-9223372036854775808,"maximum":9223372036854775807}}},
    "surfaceDirectoryRef": {"type":"object","required":["surfaceId","covers","sha256"],"additionalProperties":false,"properties":{"surfaceId":{"type":"string","minLength":1},"covers":{"$ref":"#/$defs/surfaceSlotRect"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "surfaceAddress": {"type":"object","required":["x","z","d"],"additionalProperties":false,"properties":{"x":{"$ref":"#/$defs/signedInt64Decimal"},"z":{"$ref":"#/$defs/signedInt64Decimal"},"d":{"type":"integer","minimum":1,"maximum":64}}},
    "surfaceVertex": {"type":"object","required":["surfaceId","address"],"additionalProperties":false,"properties":{"surfaceId":{"type":"string","minLength":1},"address":{"$ref":"#/$defs/surfaceAddress"}}},
    "surfaceEdge": {"type":"object","required":["patch","from","to"],"additionalProperties":false,"properties":{"patch":{"$ref":"#/$defs/patchKey"},"from":{"$ref":"#/$defs/surfaceVertex"},"to":{"$ref":"#/$defs/surfaceVertex"}}},
