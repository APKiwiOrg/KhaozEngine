{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaozengine.dev/schemas/mapdoc.schema.json",
  "title": "KhaozEngine zone map document",
  "type": "object",
  "required": ["formatVersion", "id", "bounds", "terrain"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "tileSize": { "type": "number", "exclusiveMinimum": 0 },
    "bounds": {
      "type": "object",
      "required": ["minX", "minZ", "maxX", "maxZ"],
      "additionalProperties": false,
      "properties": {
        "minX": { "type": "number" },
        "minZ": { "type": "number" },
        "maxX": { "type": "number" },
        "maxZ": { "type": "number" }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer" },
        "waterLevel": { "type": "number" },
        "biomeBlend": { "type": "number" },
        "gentleFrequency": { "type": "number" },
        "gentleAmplitude": { "type": "number" },
        "detailFrequency": { "type": "number" },
        "detailOctaves": { "type": "integer" },
        "biomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": { "type": ["number", "null"] },
              "end": { "type": ["number", "null"] },
              "biome": { "type": "string" },
              "baseHeight": { "type": "number" },
              "hillAmplitude": { "type": "number" }
            }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "scatterLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "cellSize": { "type": "number", "exclusiveMinimum": 0 },
          "jitter": { "type": "number" },
          "maxHeight": { "type": ["number", "null"] },
          "scaleMin": { "type": "number" },
          "scaleMax": { "type": "number" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "biome": { "type": "string" },
                "density": { "type": "number", "minimum": 0, "maximum": 1 },
                "kinds": { "$ref": "#/$defs/kinds" }
              }
            }
          }
        }
      }
    },
    "companionLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "hostLayer"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "hostLayer": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "hostKinds": { "type": "array", "items": { "type": "string" } },
          "kinds": { "$ref": "#/$defs/kinds" },
          "countMin": { "type": "integer", "minimum": 0 },
          "countMax": { "type": "integer", "minimum": 0 },
          "radiusMin": { "type": "number" },
          "radiusMax": { "type": "number" },
          "scaleMin": { "type": "number" },
          "scaleMax": { "type": "number" },
          "maxHeight": { "type": ["number", "null"] }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "shape": { "$ref": "#/$defs/shape" },
          "layers": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      }
    },
    "scatterOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "shape": { "$ref": "#/$defs/shape" },
          "densityMultiplier": { "type": "number", "minimum": 0 },
          "kinds": { "anyOf": [ { "$ref": "#/$defs/kinds" }, { "type": "null" } ] },
          "layers": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      }
    },
    "placements": { "$ref": "#/$defs/placements" },
    "spawns": { "$ref": "#/$defs/spawns" },
    "playerSpawns": { "$ref": "#/$defs/playerSpawns" },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "shape": { "$ref": "#/$defs/shape" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "terrainOverrides": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cellSize", "tiles"],
          "properties": {
            "cellSize": { "type": "number", "exclusiveMinimum": 0 },
            "tiles": { "$ref": "#/$defs/sculptTiles" }
          }
        }
      ]
    }
  },
  "$defs": {
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "x", "z"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "y": { "type": ["number", "null"] },
          "yaw": { "type": "number" },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "archetypeId", "x", "z"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "archetypeId": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "enabled": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "playerSpawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "z"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "yaw": { "type": "number" },
          "enabled": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sculptTiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tileX", "tileZ", "deltas"],
        "properties": {
          "tileX": { "type": "integer" },
          "tileZ": { "type": "integer" },
          "deltas": {
            "type": "array",
            "minItems": 1024,
            "maxItems": 1024,
            "items": { "type": "number" }
          }
        }
      }
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    },
    "shape": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "disc" },
            "centerX": { "type": "number" },
            "centerZ": { "type": "number" },
            "radius": { "type": "number", "minimum": 0 }
          },
          "required": ["type", "radius"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "rect" },
            "minX": { "type": "number" },
            "minZ": { "type": "number" },
            "maxX": { "type": "number" },
            "maxZ": { "type": "number" }
          },
          "required": ["type", "minX", "minZ", "maxX", "maxZ"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "polygon" },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
            }
          },
          "required": ["type", "points"],
          "additionalProperties": false
        }
      ]
    }
  }
}
