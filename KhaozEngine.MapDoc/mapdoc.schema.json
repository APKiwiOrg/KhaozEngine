{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaozengine.dev/schemas/mapdoc.schema.json",
  "title": "KhaozEngine zone map document",
  "type": "object",
  "required": ["formatVersion", "id", "bounds", "terrain"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "type": "integer", "const": 5 },
    "supportRecipe": { "type": "string", "enum": ["LegacyXzCallbackV1", "AuthoredBindingsV2"] },
    "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "tileSize": { "type": "number", "exclusiveMinimum": 0 },
    "bounds": {
      "type": "object",
      "required": ["minX", "minZ", "maxX", "maxZ"],
      "additionalProperties": false,
      "properties": {
        "minX": { "type": "number" },
        "minZ": { "type": "number" },
        "maxX": { "type": "number" },
        "maxZ": { "type": "number" }
      }
    },
    "playableBounds": {
      "type": ["object", "null"],
      "required": ["minX", "minZ", "maxX", "maxZ"],
      "additionalProperties": false,
      "properties": {
        "minX": { "type": "number" },
        "minZ": { "type": "number" },
        "maxX": { "type": "number" },
        "maxZ": { "type": "number" }
      }
    },
    "nativeAssets": { "type": "array", "items": { "$ref": "#/$defs/nativeAsset" } },
    "numericIdHighWaterMark": { "anyOf": [{ "const": "0" }, { "$ref": "#/$defs/positiveInt64Decimal" }], "description": "Nonnegative int64 decimal string, at most 9223372036854775807." },
    "resolverIdentity": {
      "type": ["object", "null"],
      "required": ["payloadVersion", "resolverVersion"],
      "additionalProperties": false,
      "properties": {
        "payloadVersion": { "type": "integer", "minimum": 1 },
        "resolverVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer" },
        "waterLevel": { "type": "number" },
        "biomeBlend": { "type": "number" },
        "gentleFrequency": { "type": "number" },
        "gentleAmplitude": { "type": "number" },
        "detailFrequency": { "type": "number" },
        "detailOctaves": { "type": "integer" },
        "biomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": { "type": ["number", "null"] },
              "end": { "type": ["number", "null"] },
              "biome": { "type": "string" },
              "baseHeight": { "type": "number" },
              "hillAmplitude": { "type": "number" }
            }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "scatterLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "cellSize": { "type": "number", "exclusiveMinimum": 0 },
          "jitter": { "type": "number" },
          "maxHeight": { "type": ["number", "null"] },
          "scaleMin": { "type": "number" },
          "scaleMax": { "type": "number" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "biome": { "type": "string" },
                "density": { "type": "number", "minimum": 0, "maximum": 1 },
                "kinds": { "$ref": "#/$defs/kinds" }
              }
            }
          }
        }
      }
    },
    "companionLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "hostLayer"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "hostLayer": { "type": "string", "minLength": 1 },
          "seed": { "type": "integer" },
          "hostKinds": { "type": "array", "items": { "type": "string" } },
          "kinds": { "$ref": "#/$defs/kinds" },
          "countMin": { "type": "integer", "minimum": 0 },
          "countMax": { "type": "integer", "minimum": 0 },
          "radiusMin": { "type": "number" },
          "radiusMax": { "type": "number" },
          "scaleMin": { "type": "number" },
          "scaleMax": { "type": "number" },
          "maxHeight": { "type": ["number", "null"] }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "shape": { "$ref": "#/$defs/shape" },
          "layers": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      }
    },
    "scatterOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "shape": { "$ref": "#/$defs/shape" },
          "densityMultiplier": { "type": "number", "minimum": 0 },
          "kinds": { "anyOf": [ { "$ref": "#/$defs/kinds" }, { "type": "null" } ] },
          "layers": { "type": ["array", "null"], "items": { "type": "string" } }
        }
      }
    },
    "placements": { "$ref": "#/$defs/placements" },
    "spawns": { "$ref": "#/$defs/spawns" },
    "playerSpawns": { "$ref": "#/$defs/playerSpawns" },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "shape"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "shape": { "$ref": "#/$defs/shape" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "terrainOverrides": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cellSize", "tiles"],
          "properties": {
            "cellSize": { "type": "number", "exclusiveMinimum": 0 },
            "tiles": { "$ref": "#/$defs/sculptTiles" }
          }
        }
      ]
    }
  },
  "$defs": {
    "positiveRational": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "additionalProperties": false,
      "properties": {
        "numerator": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "latticeFrame": {
      "type": "object",
      "required": ["cellUnitMetres", "heightUnitMetres", "rowDirection", "datum"],
      "additionalProperties": false,
      "properties": {
        "cellUnitMetres": { "$ref": "#/$defs/positiveRational" },
        "heightUnitMetres": { "$ref": "#/$defs/positiveRational" },
        "rowDirection": { "type": "string", "enum": ["PositiveZ", "NegativeZ"] },
        "datum": { "type": "string", "const": "WorldY0" }
      }
    },
    "patchKey": {
      "type": "object",
      "required": ["surfaceId", "slotX", "slotZ"],
      "additionalProperties": false,
      "properties": {
        "surfaceId": { "type": "string", "minLength": 1 },
        "slotX": { "$ref": "#/$defs/signedInt64Decimal" },
        "slotZ": { "$ref": "#/$defs/signedInt64Decimal" }
      }
    },
    "recordRef": {
      "type": "object",
      "required": ["id", "anchor"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "anchor": { "$ref": "#/$defs/patchKey" }
      }
    },
    "indoorSpan": {
      "type": ["object", "null"],
      "required": ["id", "parentSpace", "lowerOffsetUnits", "upperOffsetUnits", "domainTags"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentSpace": { "$ref": "#/$defs/recordRef" },
        "lowerOffsetUnits": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "upperOffsetUnits": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "domainTags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "surface": {
      "type": "object",
      "required": ["id", "frame", "role", "presencePolicy", "semanticSha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "frame": { "$ref": "#/$defs/latticeFrame" },
        "role": { "type": "string", "enum": ["SupportFloor", "Ceiling", "PaintOverride"] },
        "presencePolicy": { "type": "string", "enum": ["Native", "LegacyTileWorld"] },
        "paintTargetSurfaceId": { "type": ["string", "null"] },
        "indoorSpan": { "$ref": "#/$defs/indoorSpan" },
        "semanticSha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])" }
      }
    },
    "supportBinding": {
      "type": ["object", "null"],
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["Surface", "Space"] },
        "surfaceId": { "type": ["string", "null"] },
        "spaceId": { "type": ["string", "null"] },
        "referenceY": { "type": ["number", "null"] },
        "searchBelow": { "type": ["number", "null"], "minimum": 0 },
        "searchAbove": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "signedInt64Decimal": {
      "description": "Canonical int64 decimal string, preserving exact signed patch slots.",
      "anyOf": [
        { "const": "0" },
        { "$ref": "#/$defs/positiveInt64Decimal" },
        {
          "type": "string",
          "maxLength": 20,
          "pattern": "^-(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-8])(?![\\s\\S])"
        }
      ]
    },
    "positiveInt64Decimal": {
      "description": "Canonical ASCII decimal string from 1 to 9223372036854775807 with no sign or leading zero. Each alternative bounds one prefix of the int64 maximum, and the final lookahead refuses a trailing newline that a bare end anchor would allow.",
      "type": "string",
      "maxLength": 19,
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])(?![\\s\\S])"
    },
    "nativeAsset": {
      "type": "object",
      "required": ["id", "path", "sha256", "payloadVersion"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "description": "Lowercase SHA-256 hex digest, exactly 64 ASCII characters, as closure loading requires." },
        "payloadVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "x", "z"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "numericId": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/positiveInt64Decimal" }], "description": "Positive int64 decimal string, at most 9223372036854775807." },
          "assetId": { "type": ["string", "null"] },
          "displayName": { "type": ["string", "null"] },
          "supportBinding": { "$ref": "#/$defs/supportBinding" },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "y": { "type": ["number", "null"] },
          "yaw": { "type": "number" },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "archetypeId", "x", "z"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "archetypeId": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "enabled": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "playerSpawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "z"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "z": { "type": "number" },
          "yaw": { "type": "number" },
          "enabled": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sculptTiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tileX", "tileZ", "deltas"],
        "properties": {
          "tileX": { "type": "integer" },
          "tileZ": { "type": "integer" },
          "deltas": {
            "type": "array",
            "minItems": 1024,
            "maxItems": 1024,
            "items": { "type": "number" }
          }
        }
      }
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    },
    "shape": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "disc" },
            "centerX": { "type": "number" },
            "centerZ": { "type": "number" },
            "radius": { "type": "number", "minimum": 0 }
          },
          "required": ["type", "radius"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "rect" },
            "minX": { "type": "number" },
            "minZ": { "type": "number" },
            "maxX": { "type": "number" },
            "maxZ": { "type": "number" }
          },
          "required": ["type", "minX", "minZ", "maxX", "maxZ"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "polygon" },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
            }
          },
          "required": ["type", "points"],
          "additionalProperties": false
        }
      ]
    }
  }
}
