<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ke-mapedit</ToolCommandName>
    <PackageId>KhaozEngine.MapEdit.Tool</PackageId>
    <RootNamespace>KhaozEngine.MapEdit</RootNamespace>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>The ke-mapedit MCP server: opens, queries, mutates, validates, renders, and saves KhaozEngine map documents (.map.json) over stdio for AI-driven map editing. Author-time dev tool, not a runtime package.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.MapDoc/KhaozEngine.MapDoc.csproj" />
    <ProjectReference Include="../KhaozEngine.MapEditor/KhaozEngine.MapEditor.csproj" />
    <ProjectReference Include="../KhaozEngine.Imaging/KhaozEngine.Imaging.csproj" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
