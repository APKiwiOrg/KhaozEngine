<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <!-- Pinned so moved files keep their KhaozEngine.Tests.* namespaces, consistent with every other split
         test project. -->
    <RootNamespace>KhaozEngine.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- ViewportWorldTests + GltfTriangleFixtures build glb fixtures with SharpGLTF. -->
    <PackageReference Include="SharpGLTF.Toolkit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.App/KhaozEngine.App.csproj" />
    <ProjectReference Include="../KhaozEngine.Content/KhaozEngine.Content.csproj" />
    <ProjectReference Include="../KhaozEngine.Game/KhaozEngine.Game.csproj" />
    <ProjectReference Include="../KhaozEngine.Gpu/KhaozEngine.Gpu.csproj" />
    <ProjectReference Include="../KhaozEngine.Gui/KhaozEngine.Gui.csproj" />
    <ProjectReference Include="../KhaozEngine.MapDoc/KhaozEngine.MapDoc.csproj" />
    <!-- MapEditTool folder tests the MCP author-time tool (MapEdit.Tool, RootNamespace KhaozEngine.MapEdit);
         ModelContextProtocol + Microsoft.Extensions.Hosting flow transitively from it. -->
    <ProjectReference Include="../KhaozEngine.MapEdit.Tool/KhaozEngine.MapEdit.Tool.csproj" />
    <ProjectReference Include="../KhaozEngine.MapEditor/KhaozEngine.MapEditor.csproj" />
    <ProjectReference Include="../KhaozEngine.Persistence/KhaozEngine.Persistence.csproj" />
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <ProjectReference Include="../KhaozEngine.Render2D/KhaozEngine.Render2D.csproj" />
    <ProjectReference Include="../KhaozEngine.Render3D/KhaozEngine.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Terrain/KhaozEngine.Terrain.csproj" />
    <ProjectReference Include="../KhaozEngine.Windowing/KhaozEngine.Windowing.csproj" />
    <!-- ViewportWorldDisposeOrderGpuTests / RenderServiceTests use [GpuFact]. -->
    <ProjectReference Include="../KhaozEngine.TestSupport.Gpu/KhaozEngine.TestSupport.Gpu.csproj" />
    <ProjectReference Include="../KhaozEngine.TestSupport.Windowing/KhaozEngine.TestSupport.Windowing.csproj" />
  </ItemGroup>
</Project>
