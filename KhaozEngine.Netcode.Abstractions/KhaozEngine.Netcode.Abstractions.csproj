<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Netcode.Abstractions</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <Description>Zero-dependency channel-split contract for KhaozEngine netcode. IChannelSplittable&lt;TSelf&gt; declares unreliable position/transient content and reliable event content and extracts each sub-batch. NetChannelReliability names the UnreliableSequenced and ReliableOrdered channels. BCL only, for transport-agnostic DTO projects such as contracts shared with a web server. The namespace is KhaozEngine.Netcode, and KhaozEngine.Netcode type-forwards both types to this assembly so existing consumers keep binding them unchanged.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
