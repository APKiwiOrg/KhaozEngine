<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Netcode.LiteNetLib</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <Description>LiteNetLib UDP transports and channel-split sending. IChannelSplittable&lt;T&gt; and NetChannelReliability live in KhaozEngine.Netcode.Abstractions and are type-forwarded from KhaozEngine.Netcode. ChannelSplitter maps reliability to LiteNetLib's DeliveryMethod and sends each non-empty sub-batch on its channel, so reliable events never head-of-line-block position updates. Server/client transports bound undrained event inboxes with BoundedEventQueue, an optional maxQueuedEvents constructor argument and DroppedEventCount. The game keeps its own batch type and field layout.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteNetLib" />
    <ProjectReference Include="../KhaozEngine.Netcode/KhaozEngine.Netcode.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
