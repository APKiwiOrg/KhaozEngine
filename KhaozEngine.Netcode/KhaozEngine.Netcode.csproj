<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Netcode</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <Description>Game-agnostic, transport-free netcode primitives using System.Numerics. UnitAxisQuantizer provides deterministic signed-byte quantization of unit-range axes within 1/127. ClientPrediction&lt;TState,TCommand&gt; provides authoritative reconciliation, command replay and render-offset smoothing over IPredictedState/ITickSimulator with PredictionSettings. RemoteCommandQueue&lt;TCommand&gt; orders per-slot commands, rejects duplicates and tracks acknowledgements. BoundedEventQueue&lt;T&gt; caps undrained events with drop-oldest eviction and a DroppedCount counter. MessageFragmenter and MessageReassembler split and rebuild oversized payloads at an agreed chunk width, one reassembler per connection slot. The game keeps its own command/state types and packed field layout.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The channel-split contract (IChannelSplittable<T> + NetChannelReliability) lives in the
         zero-dependency Abstractions package so transport-agnostic DTO projects can implement it.
         This package type-forwards both types (see TypeForwards.cs),
         so existing consumers that reference KhaozEngine.Netcode keep binding them unchanged. -->
    <ProjectReference Include="../KhaozEngine.Netcode.Abstractions/KhaozEngine.Netcode.Abstractions.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
