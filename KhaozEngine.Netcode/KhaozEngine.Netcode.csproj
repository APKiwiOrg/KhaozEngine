<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Netcode</PackageId>
    <!-- Graduated onto the shared 5.x line at 5.46.0 (was the 4.x <Version>); MonoGame-free foundation. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>Game-agnostic, transport-free netcode primitives (System.Numerics, no MonoGame). UnitAxisQuantizer (signed-byte 8-bit quantization of a unit-range [-1,1] axis, the wire codec scheme; deterministic, round-trips within 1/127). ClientPrediction&lt;TState,TCommand&gt; (client-side prediction + authoritative reconciliation: seq-keyed pending-command buffer, ack-prune, rebase + replay of unacked commands, and decaying render-offset error smoothing with hard-snap and dead-zone) over IPredictedState/ITickSimulator with a PredictionSettings struct. RemoteCommandQueue&lt;TCommand&gt; (host-side per-slot seq-ordered command queue with duplicate/negative-seq rejection and last-acknowledged-seq tracking). BoundedEventQueue&lt;T&gt; (a drop-oldest hard cap on undrained events - the NetServer session inbox and the LiteNetLib transport inboxes use it so a stalled or flooded host cannot grow memory without bound; drops counted in DroppedCount). The game keeps its own command/state types and packed field layout.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The channel-split contract (IChannelSplittable<T> + NetChannelReliability) lives in the
         zero-dependency Abstractions package so transport-agnostic DTO projects can implement it
         without pulling MonoGame in. This package type-forwards both types (see TypeForwards.cs),
         so existing consumers that reference KhaozEngine.Netcode keep binding them unchanged. -->
    <ProjectReference Include="../KhaozEngine.Netcode.Abstractions/KhaozEngine.Netcode.Abstractions.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
