<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Particles</PackageId>
    <!-- Shared engine version line: <KhaozEngineVersion> in Directory.Build.props. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>pure, deterministic particle simulation for the custom MonoGame-free 5.x stack (System.Numerics + BCL only, no Veldrid/MonoGame). Capacity-bounded pool with swap-remove compaction so live particles are a contiguous span; per-particle lerp endpoints (size/color) + gravity + drag baked at emit time; cone-spread emission; internal xorshift32 RNG for full determinism (no System.Random / wall-clock). Render-agnostic: a 3D billboard or 2D path consumes Active. Includes EmitterConfig with Spark/Puff defaults, a RateAccumulator helper for continuous emission, and ScreenShake, the trauma-based deterministic screen-shake offset generator (absorbed from the retired KhaozEngine.Effects package in 9.0.0).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
</Project>
