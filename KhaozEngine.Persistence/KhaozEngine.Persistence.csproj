<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Persistence</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <Description>Game-agnostic save/persistence helpers: SaveEncoder (Base64 + HMAC-SHA256 tamper-deterrent), AtomicJsonWriter + PersistenceQueue (crash-safe atomic writes with per-path coalescing), SettingsManager (typed settings storage), and BatchedWriter&lt;T&gt; (bounded async batch-write queue for a server-side append-only log: caller-driven flush cadence, drop-oldest overflow, per-record salvage retry). Pure .NET (+ KhaozEngine.Diagnostics, KhaozEngine.App).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.App/KhaozEngine.App.csproj" />
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <ProjectReference Include="../KhaozEngine.Serialization/KhaozEngine.Serialization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
