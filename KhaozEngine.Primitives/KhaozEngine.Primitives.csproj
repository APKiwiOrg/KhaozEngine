<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>KhaozEngine.Primitives</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <!-- Multi-targeted below net10.0 because KhaozEngine.ServerStatus (which references this leaf)
         must be consumable from an Azure Functions app on the Linux Consumption (Y1) plan, whose
         newest supported LTS is .NET 8, not .NET 10. See the ServerStatus csproj for the full
         rationale. Blanks the single <TargetFramework> from Directory.Build.props and sets the plural
         set instead. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Zero-dependency shared primitives for KhaozEngine: Color, deterministic and fast RNG, pure math helpers (clamp/lerp/smoothstep, viewport fit/cover, easing), and the free-list ObjectPool (absorbed from the retired KhaozEngine.Pooling package in 9.0.0). System.Numerics only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- ObjectPool's per-slot generation counter is private, and winding one to the edge of int is the only
         way to test wraparound without 2^32 real rentals. Exposes the SetSlotGenerationForTest seam only. -->
    <InternalsVisibleTo Include="KhaozEngine.Foundation.Tests" />
  </ItemGroup>
</Project>
