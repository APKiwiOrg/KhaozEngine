+// SEAM CONTROL MUTANT: every tap projected onto the RECEIVER's face and clamped inside that face's cell.
+float pointShadowDepthAtClamped(texture2D atlas, sampler samp, vec3 t, vec3 base, float slot) {
+    float face; vec2 unusedUv;
+    pointShadowFace(base, face, unusedUv);
+    float ma; float sc; float tc;
+    if (face < 0.5) { ma = t.x; sc = -t.z; tc = -t.y; }
+    else if (face < 1.5) { ma = -t.x; sc = t.z; tc = -t.y; }
+    else if (face < 2.5) { ma = t.y; sc = t.x; tc = t.z; }
+    else if (face < 3.5) { ma = -t.y; sc = t.x; tc = -t.z; }
+    else if (face < 4.5) { ma = t.z; sc = t.x; tc = -t.y; }
+    else { ma = -t.z; sc = -t.x; tc = -t.y; }
+    vec2 uv = (vec2(sc, tc) / max(ma, 1e-6)) * 0.5 + 0.5;
+    vec2 texel = PointShadowAtlas.xy;
+    vec2 cellSize = vec2(1.0 / PointShadowAtlas.w, 1.0 / max(PointShadowAtlas.z, 1.0));
+    vec2 cellMin = vec2(face, slot) * cellSize;
+    vec2 tap = clamp(cellMin + uv * cellSize, cellMin + texel * 0.5, cellMin + cellSize - texel * 0.5);
+    return textureLod(sampler2D(atlas, samp), tap, 0.0).r;
+}
+
