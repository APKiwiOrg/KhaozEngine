         }
-        float stored = pointShadowDepthAt(atlas, samp, t, slot);
+        float stored = pointShadowDepthAtClamped(atlas, samp, t, dir, slot);
         if (stored + bias < d) { sum += stored; hits += 1.0; }  // this tap has something in front of the receiver
     }
