<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <!-- Pinned so moved files keep their KhaozEngine.Tests.* namespaces, consistent with every other split
         test project (goldens are loaded by [CallerFilePath], not manifest name, but the pin keeps namespaces
         and any future resource inference consistent). -->
    <RootNamespace>KhaozEngine.Tests</RootNamespace>
    <!-- The native Vulkan setup-buffer fake reads VkDependencyInfo's barrier arrays, which are raw pointers as a
         matter of ABI, and the staging-map tests write through a pinned span. Both are test-side mirrors of what
         KhaozEngine.Gpu.Vulkan is unsafe by construction for. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Render3D glTF loader tests build meshes with SharpGLTF. -->
    <PackageReference Include="SharpGLTF.Toolkit" />
    <!-- Render3D / Physics.Bepu debug-draw tests name BepuPhysics types. -->
    <PackageReference Include="BepuPhysics" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled libre font (Roboto, Apache-2.0) so the 2D golden has identical glyph input on every OS/runner,
         instead of a hard-coded macOS system-font path that doesn't exist on Windows/Linux CI. Loaded from the
         test output dir ("Assets/Roboto-Regular.ttf") by the Gpu/Render2D font tests. -->
    <None Include="Assets/Roboto-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Dungeon/DungeonKitAssetTests.cs reads assets/dungeon/dungeon.manifest.json from this test's output
         dir. The kit lives in the Showcase project (its demo renders it). Copy it straight in here so the
         test needs no Showcase project reference. That reference chained Showcase -> Audio, so an Audio- or
         Showcase-adjacent change dragged this heaviest test project into the selective affected set (#211). -->
    <None Include="../KhaozEngine.Showcase/assets/dungeon/**"
          Link="assets/dungeon/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.App/KhaozEngine.App.csproj" />
    <ProjectReference Include="../KhaozEngine.Collision/KhaozEngine.Collision.csproj" />
    <!-- Gpu/GpuTelemetryTests.cs names TelemetrySessionInfo, the telemetry session header's options type. -->
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <!-- Dungeon/DungeonKitAssetTests.cs validates the greybox kit (DungeonKitMap/DungeonPiece) against the
         committed manifest, copied straight from the Showcase asset dir below (no Showcase project reference). -->
    <ProjectReference Include="../KhaozEngine.Dungeon/KhaozEngine.Dungeon.csproj" />
    <ProjectReference Include="../KhaozEngine.Ecs/KhaozEngine.Ecs.csproj" />
    <ProjectReference Include="../KhaozEngine.Game/KhaozEngine.Game.csproj" />
    <ProjectReference Include="../KhaozEngine.Game.Render3D/KhaozEngine.Game.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Gpu/KhaozEngine.Gpu.csproj" />
    <!-- The opt-in native Direct3D11 backend. Referenced UNCONDITIONALLY, which is only possible because the
         package targets net10.0 rather than net10.0-windows (decision P1): its device-free tests then run on the
         Linux and macOS legs too, and Gpu/D3D11BackendRegistration.cs registers it for the whole test process
         through the one [ModuleInitializer] section 4.1 allows, here where assembly load is guaranteed. -->
    <ProjectReference Include="../KhaozEngine.Gpu.D3D11/KhaozEngine.Gpu.D3D11.csproj" />
    <!-- The opt-in native Vulkan backend, referenced unconditionally for the same reason and with less
         ceremony: decision V-P1 gives it net10.0 with no OS suffix and no platform guard at all, so it compiles
         and loads on every leg. GpuPublicApiTests reflects over the built assembly here for the no-Veldrid IL
         walk and the no-Silk public-surface walk, both of which need the real assembly rather than its
         project file. -->
    <ProjectReference Include="../KhaozEngine.Gpu.Vulkan/KhaozEngine.Gpu.Vulkan.csproj" />
    <!-- 7 Gpu-folder golden tests render Gui widgets (BootScreen, PatchNotesView, PopupPanel, SlotGrid, TabBar). -->
    <ProjectReference Include="../KhaozEngine.Gui/KhaozEngine.Gui.csproj" />
    <ProjectReference Include="../KhaozEngine.Imaging/KhaozEngine.Imaging.csproj" />
    <!-- Render3D/CharacterController3DTests.cs names MoveTuning to pin the controller's knob mirrors against the
         tuning's own defaults. Already in the transitive closure via Game.Render3D, so selection is unchanged. -->
    <ProjectReference Include="../KhaozEngine.Locomotion/KhaozEngine.Locomotion.csproj" />
    <!-- ParticlesRender3D folder is the Particles->Render3D seam and needs the Particles package plus its
         Render3D companion (ParticleSceneExtensions lives in KhaozEngine.Particles.Render3D, base namespace). -->
    <ProjectReference Include="../KhaozEngine.Particles/KhaozEngine.Particles.csproj" />
    <ProjectReference Include="../KhaozEngine.Particles.Render3D/KhaozEngine.Particles.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Physics/KhaozEngine.Physics.csproj" />
    <ProjectReference Include="../KhaozEngine.Physics.Bepu/KhaozEngine.Physics.Bepu.csproj" />
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <ProjectReference Include="../KhaozEngine.Render2D/KhaozEngine.Render2D.csproj" />
    <ProjectReference Include="../KhaozEngine.Render3D/KhaozEngine.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Snapshot/KhaozEngine.Snapshot.csproj" />
    <!-- Exposes SnapshotTool.DiffCommands for the headless diff/score command-layer tests (Snapshot folder). -->
    <ProjectReference Include="../SnapshotTool/SnapshotTool.csproj" />
    <ProjectReference Include="../KhaozEngine.Telegraphs/KhaozEngine.Telegraphs.csproj" />
    <!-- GroundTelegraphs (base namespace KhaozEngine.Telegraphs) lives in the Render3D companion assembly. -->
    <ProjectReference Include="../KhaozEngine.Telegraphs.Render3D/KhaozEngine.Telegraphs.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Terrain/KhaozEngine.Terrain.csproj" />
    <!-- Scene3DChunkSink (base namespace KhaozEngine.Terrain) lives in the Render3D companion assembly. -->
    <ProjectReference Include="../KhaozEngine.Terrain.Render3D/KhaozEngine.Terrain.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Windowing/KhaozEngine.Windowing.csproj" />
    <ProjectReference Include="../KhaozEngine.TestSupport/KhaozEngine.TestSupport.csproj" />
    <ProjectReference Include="../KhaozEngine.TestSupport.Gpu/KhaozEngine.TestSupport.Gpu.csproj" />
  </ItemGroup>
</Project>
