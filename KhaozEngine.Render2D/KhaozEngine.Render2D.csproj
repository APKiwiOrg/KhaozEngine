<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Render2D</PackageId>
    <!-- Shared 5.x experimental line (see docs/ROADMAP.md "The post-MonoGame pivot"). -->
    <Version>$(KhaozEngine5xVersion)</Version>
    <Description>EXPERIMENTAL 2D rendering on the custom MonoGame-free foundation (engine-owned KhaozEngine.Gpu abstraction, System.Numerics). Batched SpriteBatch with a Camera2D (position/zoom/rotation), Texture2D (PNG load via StbImageSharp), and runtime TTF text (SpriteFont via stb_truetype glyph atlas), with alpha blending and tinting. TextLayout adds device-free word-wrap + alignment over the ITextMeasurer seam; SpriteBatch supports DPI-aware scissor clipping (SetScissor/ClearScissor). Render2DSurface draws into a Windowing AppWindow; Render2DSnapshot captures headless. The GPU backend stays behind the engine-owned KhaozEngine.Gpu abstraction; this package has no direct graphics-backend dependency. Seed of the post-MonoGame 2D stack.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <ProjectReference Include="../KhaozEngine.Windowing/KhaozEngine.Windowing.csproj" />
    <ProjectReference Include="../KhaozEngine.Gpu/KhaozEngine.Gpu.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Tests" />
  </ItemGroup>
</Project>
