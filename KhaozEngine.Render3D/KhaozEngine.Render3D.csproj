<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Render3D</PackageId>
    <!-- Independent 5.x experimental line: overrides the shared 4.x Directory.Build.props version.
         The custom (MonoGame-free) rendering stack starts here. -->
    <Version>5.0.0-experimental</Version>
    <Description>EXPERIMENTAL retro/pixel 3D module on a custom MonoGame-free foundation (Veldrid + SPIR-V, System.Numerics). Orthographic IsoCamera3D, runtime glTF lit/cel model draw, and a low-res PixelPostProcess chain (swappable palette quantization, Bayer dither, depth/normal edge outline, point-sampled pixelation upscale). Seed of the post-MonoGame KhaozEngine. Deps (Veldrid/Veldrid.SPIRV/SharpGLTF) are confined to this package.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
    <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="assets/testmodel.glb" Pack="true" PackagePath="assets\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Tests" />
  </ItemGroup>
</Project>
