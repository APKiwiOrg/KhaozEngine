<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Render3D</PackageId>
    <!-- Shared 5.x experimental line (custom MonoGame-free stack), versioned via Directory.Build.props. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>stylized 3D module on a custom MonoGame-free foundation (KhaozEngine.Gpu seam, System.Numerics). Orthographic IsoCamera3D (+ IsoCameraController: cursor-anchored scroll-zoom and grab-pan), runtime glTF lit/cel model draw with optional per-mesh albedo textures (UV sampling, 1x1 white default), a procedural starfield, and a PixelPostProcess chain (smooth or retro: swappable palette quantization, Bayer dither, depth/normal edge outline, point-or-linear upscale). Default look is smooth stylized space; retro/pixel is a toggle. Seed of the post-MonoGame KhaozEngine. All GPU work routes through KhaozEngine.Gpu; SharpGLTF handles model loading.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <!-- The MonoGame-free ECS, so 3D entities can render via Scene3DBinder (Transform3D + MeshInstance). -->
    <ProjectReference Include="../KhaozEngine.Ecs/KhaozEngine.Ecs.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="assets/testmodel.glb" Pack="true" PackagePath="assets\" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/asteroid.glb" Pack="true" PackagePath="assets\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Windowing/KhaozEngine.Windowing.csproj" />
    <ProjectReference Include="../KhaozEngine.Gpu/KhaozEngine.Gpu.csproj" />
    <!-- Primitives.Color is the canonical RGBA type across the public 3D color API (Scene3D, Material, Palette). -->
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <!-- Render3DPreview returns a Render2D.Texture2D so an offscreen 3D model preview is drawable by a
         SpriteBatch. Render2D already ships in every Game3D consumer (Game3D is a superset of Game2D). -->
    <ProjectReference Include="../KhaozEngine.Render2D/KhaozEngine.Render2D.csproj" />
    <!-- AssetEntry.Collider carries an optional static-collision footprint (ColliderShape). -->
    <ProjectReference Include="../KhaozEngine.Collision/KhaozEngine.Collision.csproj" />
    <!-- PropCollisionBake/PropCollisionLoader use the physics shape seam (no Bepu dependency). -->
    <ProjectReference Include="../KhaozEngine.Physics/KhaozEngine.Physics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Tests" />
  </ItemGroup>
</Project>
