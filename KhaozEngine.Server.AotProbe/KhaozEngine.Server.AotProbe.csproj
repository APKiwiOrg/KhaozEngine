<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The server-tick surface: the shard host (Sharding), the per-tick capture/delta replicator
         (Replication), and the ECS World they run over (Ecs). Simulation flows in transitively via
         Sharding. NetWorld is referenced too (added when world save/load + NetWorld persistence went
         AOT-clean) so the probe also gates the ECS world JSON save/load path (WorldSerializer) and the
         durable NetWorld DTO round-trips (PlayerRecord / WorldMetaRecord / WorldStoreBanStore). NetWorld
         drags Netcode.LiteNetLib (native transport) and the WorldStore core into the closure, but the
         probe never touches the transport, so it trims away; only the save/load + record paths are
         exercised. The Server umbrella metapackage is still not referenced (it would add more than the
         gate needs). -->
    <ProjectReference Include="../KhaozEngine.Ecs/KhaozEngine.Ecs.csproj" />
    <ProjectReference Include="../KhaozEngine.Replication/KhaozEngine.Replication.csproj" />
    <ProjectReference Include="../KhaozEngine.Sharding/KhaozEngine.Sharding.csproj" />
    <ProjectReference Include="../KhaozEngine.NetWorld/KhaozEngine.NetWorld.csproj" />
  </ItemGroup>
  <!-- No rd.xml: unlike the Physics probe (Bepu's Solver.Register<T> needs Activator.CreateInstance
       rooted), every path here is reflection-free - ReplicationRegistry.Register<T> and the ECS generic
       component API close over T statically, world save/load goes through a source-generated envelope
       context + the generic column-factory seam, and the NetWorld DTOs use source-generated contexts, so
       nothing here needs a runtime-type root. -->
</Project>
