<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Server</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Headless authoritative server bundle with Foundation, Netcode, Netcode.Abstractions, Netcode.LiteNetLib, Simulation, Replication, WorldStore checkpoint and mutation-journal contracts, ItemInstances.Journal container loading and batched commits, Catalog.Authoring, Catalog.Netcode, Sharding, NetWorld and TileWorld.Netcode. Includes the dependency-free physics seam and code-health analyzer. SQLite and SQL Server providers remain opt-in. Carries no graphics, windowing or audio. Contracts-only projects can reference Netcode.Abstractions alone. Contains only dependencies.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <!-- NU5128: this is a dependency-only umbrella metapackage (IncludeBuildOutput=false, no lib/
         content of its own) whose only content is the ProjectReference set above; NuGet warns that
         the package has dependencies but no lib assets for any TFM, which is expected here. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- Code-free dependency group: the packed reference below carries the analyzer to consumers, and
         the repo-wide Analyzer-typed dogfood reference would duplicate it. -->
    <KhaozSkipFileSizeAnalyzer>true</KhaozSkipFileSizeAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <!-- GPU-free foundation -->
    <!-- PrivateAssets keeps the BUILD asset flowing to the consumer (#722). The ProjectReference
         default is contentfiles;analyzers;build, which stamps exclude="Build,Analyzers" on the packed
         dependency, and that is what stopped Foundation's build/ files (the CETCompat and single-file
         defaults, and now the Linux host-native flatten) from ever reaching a head. Analyzers stay
         private here, they travel on their own include="All" dependencies below. -->
    <ProjectReference Include="../KhaozEngine.Foundation/KhaozEngine.Foundation.csproj"
                      PrivateAssets="contentfiles;analyzers" />
    <!-- networking -->
    <ProjectReference Include="../KhaozEngine.Netcode/KhaozEngine.Netcode.csproj" />
    <ProjectReference Include="../KhaozEngine.Netcode.Abstractions/KhaozEngine.Netcode.Abstractions.csproj" />
    <ProjectReference Include="../KhaozEngine.Netcode.LiteNetLib/KhaozEngine.Netcode.LiteNetLib.csproj" />
    <!-- simulation host -->
    <ProjectReference Include="../KhaozEngine.Simulation/KhaozEngine.Simulation.csproj" />
    <!-- entity replication -->
    <ProjectReference Include="../KhaozEngine.Replication/KhaozEngine.Replication.csproj" />
    <!-- world store: ONLY the dependency-free durable-state seam (IWorldStore + InMemoryWorldStore).
         The SQLite / SQL Server backends are deliberately NOT bundled here: pulling them in dragged
         Microsoft.Data.Sqlite -> SQLitePCLRaw (NU1903) + Microsoft.Data.SqlClient into every umbrella
         consumer, even those using one backend or none. Consumers add the backend package they want
         explicitly (KhaozEngine.WorldStore.Sqlite or .SqlServer). -->
    <ProjectReference Include="../KhaozEngine.WorldStore/KhaozEngine.WorldStore.csproj" />
    <!-- the journal side of the item instance record: the page section naming and the container load
         path. It is a Server package for a LAYERING reason rather than a size one: composing a
         JournalCommit needs WorldStore, so the same code inside KhaozEngine.ItemInstances would drag a
         Server package into Foundation and therefore into every client build. -->
    <ProjectReference Include="../KhaozEngine.ItemInstances.Journal/KhaozEngine.ItemInstances.Journal.csproj" />
    <!-- the content catalog's server half: the authoring seam and publish pipeline, and the content layer
         of the connect door. Both are Server packages for a LAYERING reason: Foundation carries the read
         side (KhaozEngine.Catalog) a client links, and neither of these may enter a client graph. The two
         SQL authoring providers are opt-in sibling packages, not bundled, matching WorldStore's pair. -->
    <ProjectReference Include="../KhaozEngine.Catalog.Authoring/KhaozEngine.Catalog.Authoring.csproj" />
    <ProjectReference Include="../KhaozEngine.Catalog.Netcode/KhaozEngine.Catalog.Netcode.csproj" />
    <!-- world topology (cell grid / shard host) -->
    <ProjectReference Include="../KhaozEngine.Sharding/KhaozEngine.Sharding.csproj" />
    <!-- networked-world movement layer (server sim + client glue, render-free) -->
    <ProjectReference Include="../KhaozEngine.NetWorld/KhaozEngine.NetWorld.csproj" />
    <!-- the tile-world movement layer: a SIBLING of NetWorld over the same generic layers, never a dependent
         of it. Server-side here. A client head references the package by id, exactly as a client head already
         references NetWorld (Game3D carries no networking). -->
    <ProjectReference Include="../KhaozEngine.TileWorld.Netcode/KhaozEngine.TileWorld.Netcode.csproj" />
    <!-- physics seam only; the BepuPhysics backend (KhaozEngine.Physics.Bepu) is an opt-in sibling
         package, not bundled here - matching the WorldStore.Sqlite/.SqlServer pattern above -->
    <ProjectReference Include="../KhaozEngine.Physics/KhaozEngine.Physics.csproj" />
    <!-- File-size ratchet analyzer: packs as a dependency so it flows to any consumer of this umbrella.
         PrivateAssets="none" keeps the Analyzers+Build assets in the packed dependency (the
         ProjectReference default excludes them), so the analyzer and its buildTransitive baseline
         discovery actually apply in the consumer's build. All four umbrellas carry it, unlike the
         localization analyzer: the ratchet applies to server and foundation code too. -->
    <ProjectReference Include="../KhaozEngine.CodeHealth.Analyzers/KhaozEngine.CodeHealth.Analyzers.csproj"
                      PrivateAssets="none" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
