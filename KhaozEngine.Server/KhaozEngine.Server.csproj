<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Server</PackageId>
    <Version>$(KhaozEngine5xVersion)</Version>
    <Description>Umbrella metapackage for a headless / server-side build on the KhaozEngine 5.x stack: the MonoGame-free, GPU-free Foundation (Ecs/Serialization/Content/Persistence/Diagnostics/App/Localization/Collision/Pooling/Platform/Updates) plus the networking layer (Netcode/Netcode.Abstractions/Netcode.LiteNetLib). Pulls in NO graphics, windowing, audio, or GPU, so an authoritative sim server or tool stays lean. (A contracts-only project that just needs the wire types should reference KhaozEngine.Netcode.Abstractions directly instead.) Contains no code; just dependencies.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- GPU-free foundation -->
    <ProjectReference Include="../KhaozEngine.Foundation/KhaozEngine.Foundation.csproj" />
    <!-- networking -->
    <ProjectReference Include="../KhaozEngine.Netcode/KhaozEngine.Netcode.csproj" />
    <ProjectReference Include="../KhaozEngine.Netcode.Abstractions/KhaozEngine.Netcode.Abstractions.csproj" />
    <ProjectReference Include="../KhaozEngine.Netcode.LiteNetLib/KhaozEngine.Netcode.LiteNetLib.csproj" />
    <!-- simulation host -->
    <ProjectReference Include="../KhaozEngine.Simulation/KhaozEngine.Simulation.csproj" />
    <!-- entity replication -->
    <ProjectReference Include="../KhaozEngine.Replication/KhaozEngine.Replication.csproj" />
    <!-- world store -->
    <ProjectReference Include="../KhaozEngine.WorldStore/KhaozEngine.WorldStore.csproj" />
  </ItemGroup>
</Project>
