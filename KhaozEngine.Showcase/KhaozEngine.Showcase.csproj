<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Reference desktop head for the WinExe standard (docs/USING-KHAOZENGINE.md "Game head build settings"):
         a game head ships as WinExe so no stray console window opens behind the game on Windows. WinExe is a
         no-op off Windows (it builds a normal executable), so this still runs on the mac/Linux CI windowed smoke.
         The engine attaches the parent console at startup (GameApp -> AppWindow.TryAttachParentConsole), so a
         `dotnet run` from a terminal still shows this head's stdout/stderr. Every game's Desktop head mirrors this. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Window/Dock icon: the KhaozEngine brand mark, linked from the committed generated pack (one
         master drives it via scripts/generate-icons.py). See art-assets/icon/README.md. -->
    <None Include="..\art-assets\icon\generated\windowicon\icon_256.png" Link="assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/props/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/character/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/buildings/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The map-editor room's demo document (KhaozEngine.MapEditor). The schema is linked straight from the
         canonical KhaozEngine.MapDoc copy below, not a hand-kept duplicate, so it can never drift. -->
    <None Include="assets/maps/**" Exclude="assets/maps/schemas/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../KhaozEngine.MapDoc/mapdoc.schema.json" Link="assets/maps/schemas/mapdoc.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Greybox KhaozEngine.Dungeon kit pieces (DungeonKitMap.Greybox() ids); see assets/dungeon/CREDITS.md. -->
    <None Include="assets/dungeon/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sample player changelog for the 2D and GUI room's "Patch notes" launcher. LogicalName matches
         PatchNotesLoader.ResourceName, so PatchNotesLoader.Load(typeof(Room2DGui).Assembly) finds it as an
         embedded resource (no disk copy shipped alongside the showcase binary). -->
    <EmbeddedResource Include="PLAY_CHANGELOG.md">
      <LogicalName>PLAY_CHANGELOG.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Let the engine test project verify the localization catalog (ShowcaseStrings + resx) resolves. -->
    <InternalsVisibleTo Include="KhaozEngine.Tests" />
    <!-- Run the localization analyzer on the showcase (the worked example) so KELOC001/002 are enforced here
         in-repo, proving the diagnostics fire on real consumer-style code. -->
    <ProjectReference Include="../KhaozEngine.Localization.Analyzers/KhaozEngine.Localization.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Windowing/KhaozEngine.Windowing.csproj" />
    <ProjectReference Include="../KhaozEngine.Render2D/KhaozEngine.Render2D.csproj" />
    <ProjectReference Include="../KhaozEngine.Gui/KhaozEngine.Gui.csproj" />
    <ProjectReference Include="../KhaozEngine.Audio/KhaozEngine.Audio.csproj" />
    <ProjectReference Include="../KhaozEngine.Game/KhaozEngine.Game.csproj" />
    <ProjectReference Include="../KhaozEngine.Game.Render3D/KhaozEngine.Game.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Render3D/KhaozEngine.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Terrain/KhaozEngine.Terrain.csproj" />
    <ProjectReference Include="../KhaozEngine.Terrain.Render3D/KhaozEngine.Terrain.Render3D.csproj" />
    <ProjectReference Include="../KhaozEngine.Physics/KhaozEngine.Physics.csproj" />
    <ProjectReference Include="../KhaozEngine.Physics.Bepu/KhaozEngine.Physics.Bepu.csproj" />
    <ProjectReference Include="../KhaozEngine.NetWorld/KhaozEngine.NetWorld.csproj" />
    <ProjectReference Include="../KhaozEngine.Locomotion/KhaozEngine.Locomotion.csproj" />
    <ProjectReference Include="../KhaozEngine.Netcode.LiteNetLib/KhaozEngine.Netcode.LiteNetLib.csproj" />
    <ProjectReference Include="../KhaozEngine.Simulation/KhaozEngine.Simulation.csproj" />
    <ProjectReference Include="../KhaozEngine.MapDoc/KhaozEngine.MapDoc.csproj" />
    <ProjectReference Include="../KhaozEngine.MapEditor/KhaozEngine.MapEditor.csproj" />
    <!-- RoomDungeon: DungeonGenerator + DungeonStamp for the walkable dungeon-generator demo room. -->
    <ProjectReference Include="../KhaozEngine.Dungeon/KhaozEngine.Dungeon.csproj" />
  </ItemGroup>
</Project>
