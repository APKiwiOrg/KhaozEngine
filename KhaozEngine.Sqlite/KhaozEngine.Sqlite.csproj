<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Sqlite</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <Description>The shared SQLite store lifecycle every KhaozEngine.*.Sqlite backend sits on: SqliteStoreConnection holds one open connection that is never pooled, bootstraps the store's schema, serializes commands behind a lease, and closes the connection on dispose, so the database file is genuinely released and no pool operation elsewhere in the process can lend or close a live store's handle. Extracted after the same pooled-handle leak shipped three times. Schema, SQL and record shape stay with the store; this package owns the lifecycle and nothing else.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Override the bundled native SQLite binary to the patched build (SQLite 3.50.3, fixes
         CVE-2025-6965 / NU1903). Microsoft.Data.Sqlite 10.0.9 still pulls the vulnerable
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively; this direct ref upgrades ONLY the native
         lib (managed SQLitePCLRaw.core/provider stay at 2.1.11, the versions MDS is built against).
         Drop this pin once Microsoft.Data.Sqlite references a patched SQLitePCLRaw itself. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
