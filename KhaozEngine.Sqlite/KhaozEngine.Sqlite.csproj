<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Sqlite</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <Description>Shared SQLite store lifecycle and schema widening. SqliteStoreConnection holds one unpooled connection, serializes commands behind a lease, and closes it on dispose. SqliteSchemaWidening inspects declared tables, columns and indexes without taking the write lock, then rechecks missing requirements under an immediate transaction before running idempotent schema DDL. Schema definitions, SQL and record shape stay with the store.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Override the bundled native SQLite binary to the patched build (SQLite 3.50.3, fixes
         CVE-2025-6965 / NU1903). Microsoft.Data.Sqlite 10.0.9 still pulls the vulnerable
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 transitively; this direct ref upgrades ONLY the native
         lib (managed SQLitePCLRaw.core/provider stay at 2.1.11, the versions MDS is built against).
         Drop this pin once Microsoft.Data.Sqlite references a patched SQLitePCLRaw itself. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
