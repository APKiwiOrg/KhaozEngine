<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.StatusEffects</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Deterministic, tick-based status effects on actors with scoped stacking, refresh, periodic events, expiry and integer modifier totals. Games own definitions, channel meaning, the simulation clock and gameplay responses. No engine runtime dependencies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
