<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Not a test project and ships nothing: excluded from the doc-version guard's packable-package
         catalog check (it greps for this literal tag). -->
    <IsPackable>false</IsPackable>
    <!-- Helper library, not a test host. It references xunit only for the FactAttribute base class that
         GpuFactAttribute derives from, and carries no test SDK or runner. Without this, solution-level
         dotnet test discovers it as a test project, spins a testhost against a DLL with no adapter, and
         that testhost crashes and fails the whole run. Pin it false so discovery skips it. -->
    <IsTestProject>false</IsTestProject>
    <!-- GpuFactAttribute keeps its KhaozEngine.Tests.Gpu namespace, consistent with every split test
         project, so the [GpuFact] users resolve it unchanged. -->
    <RootNamespace>KhaozEngine.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- FactAttribute (the base class) only; not a test project, so no test SDK / runner. -->
    <PackageReference Include="xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- GpuFactAttribute and GpuTheoryAttribute delegate the shared environment and device gate here. -->
    <ProjectReference Include="../KhaozEngine.Gpu.TestKit/KhaozEngine.Gpu.TestKit.csproj" />
    <!-- Capability-specific attribute probes and the shared uniform-ring adapters use the GPU seam directly. -->
    <ProjectReference Include="../KhaozEngine.Gpu/KhaozEngine.Gpu.csproj" />
    <!-- The Direct3D 11 uniform-ring adapter and the filtered registration-test helper use this backend. The
         packable Gpu.TestKit owns attribute-gated registration. Safe to reference
         unconditionally on every OS: the package is net10.0, not net10.0-windows, and its Windows boundary is
         platform guards over NoInlining bodies, so nothing here puts the Vortice interop on the load path off
         Windows (decision P1). -->
    <ProjectReference Include="../KhaozEngine.Gpu.D3D11/KhaozEngine.Gpu.D3D11.csproj" />
    <!-- The Vulkan uniform-ring adapter and the filtered registration-test helper use this backend. Safe to
         reference unconditionally for a simpler reason than the Direct3D 11 package needs: decision V-P1 gives
         it net10.0 with no OS suffix and no platform guard at all, because Vulkan is not a Windows API. The
         Vulkan loader is resolved at runtime and a machine without one answers the functional probe with false,
         so referencing this on macOS costs nothing and loads nothing. -->
    <ProjectReference Include="../KhaozEngine.Gpu.Vulkan/KhaozEngine.Gpu.Vulkan.csproj" />
    <!-- The Metal uniform-ring adapter and the filtered registration-test helper use this backend. Safe to
         reference unconditionally for the Direct3D 11 package's reason rather than the Vulkan package's:
         decision M-P1 gives it net10.0 with no OS suffix and a [SupportedOSPlatformGuard("macos")] over
         NoInlining bodies, so referencing it on Linux or Windows loads no Objective-C and the JIT never
         compiles a body that names a Metal selector. -->
    <ProjectReference Include="../KhaozEngine.Gpu.Metal/KhaozEngine.Gpu.Metal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- GpuFactSkipReasonTests (Render.Tests) exercises capability-specific internal skip decisions. -->
    <InternalsVisibleTo Include="KhaozEngine.Render.Tests" />
  </ItemGroup>
</Project>
