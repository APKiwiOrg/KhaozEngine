<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/sample.json" />
    <!-- Bundled libre font (Roboto, Apache-2.0) so the 2D golden has identical glyph input on every OS/runner,
         instead of a hard-coded macOS system-font path that doesn't exist on Windows/Linux CI. -->
    <None Include="Assets/Roboto-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- A captured real one-sided building collision mesh (a Ruinborne house with eaves/overhangs), used as a
         realistic regression fixture for the swept resolver: complex one-sided geometry with eaves is exactly where
         the resolver's one-sided-mesh handling must not pin or float the capsule. -->
    <None Include="Physics/Fixtures/building_with_eaves.coll" CopyToOutputDirectory="PreserveNewest" />
    <!-- A REAL authored collision PROXY (compound of convex boxes) baked by ke-propbake from a blacksmith
         <id>_collision.glb. The goal-metric fixture for the collision-proxy pipeline: a convex proxy must be
         wedge-free (the capsule can always walk or jump out) while keeping the body + furniture standable. -->
    <None Include="Physics/Fixtures/blacksmith_proxy.coll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
