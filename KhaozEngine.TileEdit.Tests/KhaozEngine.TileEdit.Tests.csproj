<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <!-- Pinned so the declared namespaces stay KhaozEngine.Tests.*, consistent with every other split
         test project. -->
    <RootNamespace>KhaozEngine.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- TWO references, and no more. Push CI selects test projects by the reference graph, so a third would
         only widen what an unrelated diff drags in.
         The tool (RootNamespace KhaozEngine.TileEdit) brings TileWorld.Editing, TileWorld.Render3D, Imaging,
         ModelContextProtocol and Microsoft.Extensions.Hosting transitively. -->
    <ProjectReference Include="../KhaozEngine.TileEdit.Tool/KhaozEngine.TileEdit.Tool.csproj" />
    <!-- TestSupport.Gpu is here for [GpuFact] alone, which gates the render rows on a real headless device and
         registers the native backends for this assembly. Same precedent as KhaozEngine.MapEditor.Tests, whose
         RenderService rows need exactly this and nothing else. -->
    <ProjectReference Include="../KhaozEngine.TestSupport.Gpu/KhaozEngine.TestSupport.Gpu.csproj" />
  </ItemGroup>
</Project>
