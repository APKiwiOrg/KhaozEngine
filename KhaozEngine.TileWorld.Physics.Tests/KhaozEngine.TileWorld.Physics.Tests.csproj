<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <!-- Pinned so the declared namespaces stay KhaozEngine.Tests.TileWorld.Physics.*, per AGENTS.md. -->
    <RootNamespace>KhaozEngine.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- The package, which brings TileWorld, Physics and Locomotion with it. -->
    <ProjectReference Include="../KhaozEngine.TileWorld.Physics/KhaozEngine.TileWorld.Physics.csproj" />
    <!-- The shipped backend, so the colliders are proven against a real IPhysicsWorld rather than a test double. -->
    <ProjectReference Include="../KhaozEngine.Physics.Bepu/KhaozEngine.Physics.Bepu.csproj" />
    <ProjectReference Include="../KhaozEngine.Movement/KhaozEngine.Movement.csproj" />
    <ProjectReference Include="../KhaozEngine.NetWorld/KhaozEngine.NetWorld.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../test-shared/WaterPrismCensus/*.cs" Link="Fixtures/WaterPrismCensus/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/TileInstallationBaseline.json" />
    <EmbeddedResource Include="Fixtures/TileInstallationBaseline.navbake" />
    <EmbeddedResource Include="Fixtures/ContactTerrainFormatFour.navbake" />
    <EmbeddedResource Include="Fixtures/WaterPrismCensusBaseline.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../KhaozEngine.Game.Tests/Locomotion/Contacts/LocomotionStateBits.cs" Link="Fixtures/LocomotionStateBits.cs" />
    <Compile Include="../KhaozEngine.Movement.Tests/Fixtures/ArrivalReference.cs" Link="Fixtures/ArrivalReference.cs" />
  </ItemGroup>
  <Import Project="../test-shared/AllocationMeasurement.props" />
</Project>
