{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khaozengine.dev/schemas/tileworld.catalog.schema.json",
  "title": "KhaozEngine tile world catalog",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "color"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "name": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "texture": { "type": "string" },
          "kind": { "type": "string", "enum": ["Ground", "Water"] },
          "tilesPerMetre": { "type": "number", "minimum": 0.01 }
        },
        "additionalProperties": false
      }
    },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "meshRef"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "meshRef": { "type": "string", "minLength": 1 },
          "sizeX": { "type": "integer", "minimum": 1, "maximum": 64 },
          "sizeZ": { "type": "integer", "minimum": 1, "maximum": 64 },
          "collisionKind": { "type": "string", "enum": ["None", "Solid", "Wall", "WallCorner", "Diagonal"] },
          "isRoof": { "type": "boolean" },
          "interactive": { "type": "boolean" },
          "yawOffsetDegrees": { "type": "number" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
