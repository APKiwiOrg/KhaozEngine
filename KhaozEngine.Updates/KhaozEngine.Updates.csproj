<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Updates</PackageId>
    <!-- Graduated onto the shared 5.x line at 5.46.0 (was the 4.x <Version>); MonoGame-free foundation. -->
    <Version>$(KhaozEngineVersion)</Version>
    <Description>Game-agnostic delta auto-update pipeline: SHA256 file manifests + diffing, a host-agnostic update source (default HTTP/Azure Blob transport, configurable endpoint), an UpdateService state machine with resumable staged downloads, and a cross-platform staged-apply core (back-up + rollback + relaunch) for an external updater shim. Pure .NET (+ KhaozEngine.Diagnostics, KhaozEngine.Platform, KhaozEngine.Primitives), no MonoGame dependency.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The Windows updater window uses a function-pointer WndProc (delegate* unmanaged) so it stays
         trim/AOT-safe (no delegate marshalling); that needs unsafe blocks. All Win32 P/Invoke is
         [SupportedOSPlatform("windows")] and never called off Windows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <!-- Platform is the BCL-only leaf that owns WindowsConsole; the shim attaches the parent console so its
         diagnostics stay reachable when it ships as a WinExe. Both are already in the Foundation umbrella. -->
    <ProjectReference Include="../KhaozEngine.Platform/KhaozEngine.Platform.csproj" />
    <!-- UpdateVersion delegates its numeric x.y.z compare to the shared VersionComparer leaf. -->
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Foundation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="templates/*.sh" Pack="true" PackagePath="templates/" />
  </ItemGroup>
</Project>
