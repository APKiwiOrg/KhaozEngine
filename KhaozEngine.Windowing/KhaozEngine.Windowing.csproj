<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Windowing</PackageId>
    <!-- Shared 5.x experimental custom-stack line. -->
    <Version>$(KhaozEngine5xVersion)</Version>
    <Description>windowing + input foundation for the custom MonoGame-free stack. AppWindow owns the Silk.NET window (GLFW natives bundled per-RID, no brew install sdl2), input, and frame loop; the Veldrid device/swapchain are created behind the KhaozEngine.Gpu seam from the native window handle. Each frame exposes an engine-native InputState (keyboard + mouse + gamepad, no MonoGame) and the render target. Shared by the 5.x renderers. Part of the post-MonoGame 5.x line.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.22.0" />
    <ProjectReference Include="../KhaozEngine.Gpu/KhaozEngine.Gpu.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Tests" />
  </ItemGroup>
</Project>
