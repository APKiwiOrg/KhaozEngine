<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.Windowing</PackageId>
    <!-- Shared 5.x custom-stack line. -->
    <Version>$(KhaozEngineVersion)</Version>
    <!-- unsafe: GlfwClipboard passes the native GLFW WindowHandle* to Silk's clipboard API. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>windowing + input foundation for the custom MonoGame-free stack. AppWindow owns the Silk.NET window (GLFW natives bundled per-RID, no brew install sdl2), input, and frame loop; the Veldrid device/swapchain are created behind the KhaozEngine.Gpu seam from the native window handle. Each frame exposes an engine-native InputState (keyboard + mouse + gamepad, no MonoGame) and the render target. AppWindow also wires a GLFW-backed text clipboard into KhaozEngine.Platform's Clipboard (the working Windows/Linux text get/set path). A GameClock (real/scaled delta, pause, timescale) and a TimeSkip (one-shot offline / fast-forward catch-up with cap/multiplier/min policy) cover frame timing + away-time. Shared by the 5.x renderers. Part of the post-MonoGame 5.x line.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <ProjectReference Include="../KhaozEngine.Platform/KhaozEngine.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Input.Glfw" />
    <PackageReference Include="Silk.NET.GLFW" />
    <ProjectReference Include="../KhaozEngine.Gpu/KhaozEngine.Gpu.csproj" />
    <!-- The three engine-owned native GPU backends, for GpuBackends.RegisterPlatformDefault(). They stopped
         being opt-in in 18.0.0, when the Veldrid backend KhaozEngine.Gpu used to build itself was deleted: a
         seam with no built-in implementation left means a consumer that references no backend package has no
         device at all, so "pay for what you use" had nothing to protect any more. This is the lowest package
         above the seam that every windowed host and every in-repo headless host already carries, which is why
         the registration helper lives here rather than in a fourth package of its own. -->
    <ProjectReference Include="../KhaozEngine.Gpu.Metal/KhaozEngine.Gpu.Metal.csproj" />
    <ProjectReference Include="../KhaozEngine.Gpu.D3D11/KhaozEngine.Gpu.D3D11.csproj" />
    <ProjectReference Include="../KhaozEngine.Gpu.Vulkan/KhaozEngine.Gpu.Vulkan.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Render.Tests" />
    <InternalsVisibleTo Include="KhaozEngine.Game.Tests" />
  </ItemGroup>
</Project>
