<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KhaozEngine.WorldStore</PackageId>
    <Version>$(KhaozEngineVersion)</Version>
    <Description>Dependency-free server persistence for authoritative worlds. Includes IWorldStore checkpoint storage, StatePersistence lifecycle orchestration, and the durable mutation journal contract with immutable values, checked recovery, selected-stream projections, in-memory reference storage, and a bounded commit executor. SQLite and SQL Server providers remain opt-in sibling packages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KhaozEngine.Server.Tests" />
    <!-- Non-packable local crash harness. Provider fault hooks remain internal. -->
    <InternalsVisibleTo Include="KhaozEngine.Benchmarks" />
    <InternalsVisibleTo Include="KhaozEngine.WorldStore.Sqlite" />
    <InternalsVisibleTo Include="KhaozEngine.WorldStore.SqlServer" />
  </ItemGroup>
</Project>
