<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SnapshotTool</AssemblyName>
    <RootNamespace>SnapshotTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- A 2D+3D snapshot tool references the 2D harness plus its 3D arm; Render2D/Render3D flow transitively. -->
    <ProjectReference Include="../KhaozEngine.Snapshot/KhaozEngine.Snapshot.csproj" />
    <ProjectReference Include="../KhaozEngine.Snapshot.Render3D/KhaozEngine.Snapshot.Render3D.csproj" />
  </ItemGroup>
</Project>
