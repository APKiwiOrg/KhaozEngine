<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The smoke run restores KhaozEngine.Native from a run-local feed folder named by KHAOZ_NATIVE_FEED.
       Everything else keeps nuget.org, mapped as in the repository root config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="khaoz-native-feed" value="%KHAOZ_NATIVE_FEED%" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="khaoz-native-feed">
      <package pattern="KhaozEngine.Native" />
    </packageSource>
  </packageSourceMapping>
</configuration>
