<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="./local-feed" />
    <add key="github" value="https://nuget.pkg.github.com/APKiwiOrg/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- CPM wants explicit source mapping (NU1507). External deps come from nuget.org only, and the local dev
          feed and GitHub Packages only ever serve KhaozEngine.* ids. The vendored Veldrid fork and its
          veldrid-fork source went with the incumbent backend in 18.0.0: the only Veldrid left in the graph is
          stock, and it arrives under Veldrid.SPIRV. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="KhaozEngine.*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="KhaozEngine.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="APKiwi" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_PAT%" />
    </github>
  </packageSourceCredentials>
</configuration>
