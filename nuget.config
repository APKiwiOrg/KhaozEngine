<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="./local-feed" />
    <add key="github" value="https://nuget.pkg.github.com/APKiwi/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="APKiwi" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_PAT%" />
    </github>
  </packageSourceCredentials>
</configuration>
