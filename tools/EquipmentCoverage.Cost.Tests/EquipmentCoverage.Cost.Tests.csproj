<Project Sdk="Microsoft.NET.Sdk">
  <!-- Historical CPU authorization files remain packaged for inspection. Every measurement entry rejects.
       GPU measurement requires fresh approval and a separate harness. This project is build-only in Part C. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <RootNamespace>KhaozEngine.Tests.CoverageCost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../KhaozEngine.Render.Tests/KhaozEngine.Render.Tests.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="authorized/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="authorized" />
  </ItemGroup>
</Project>
