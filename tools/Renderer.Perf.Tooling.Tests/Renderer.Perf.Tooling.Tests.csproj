<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
    <RootNamespace>KhaozEngine.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <EmbeddedResource Include="Gpu/RendererPerf/controls/*.glsl" />
    <!-- UI recipes hash the same bundled font bytes as the engine golden fixtures. -->
    <None Include="../../KhaozEngine.Render.Tests/Assets/Roboto-Regular.ttf"
          Link="Assets/Roboto-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../KhaozEngine.Diagnostics/KhaozEngine.Diagnostics.csproj" />
    <ProjectReference Include="../../KhaozEngine.Gpu/KhaozEngine.Gpu.csproj" />
    <ProjectReference Include="../../KhaozEngine.Gpu.D3D11/KhaozEngine.Gpu.D3D11.csproj" />
    <ProjectReference Include="../../KhaozEngine.Gpu.Metal/KhaozEngine.Gpu.Metal.csproj" />
    <ProjectReference Include="../../KhaozEngine.Gpu.Vulkan/KhaozEngine.Gpu.Vulkan.csproj" />
    <ProjectReference Include="../../KhaozEngine.Primitives/KhaozEngine.Primitives.csproj" />
    <ProjectReference Include="../../KhaozEngine.Render2D/KhaozEngine.Render2D.csproj" />
    <ProjectReference Include="../../KhaozEngine.Render3D/KhaozEngine.Render3D.csproj" />
    <ProjectReference Include="../../KhaozEngine.Windowing/KhaozEngine.Windowing.csproj" />
    <ProjectReference Include="../../KhaozEngine.TestSupport.Gpu/KhaozEngine.TestSupport.Gpu.csproj" />
  </ItemGroup>
  <Import Project="../../test-shared/RendererPerfShared.props" />
  <Import Project="../../test-shared/AllocationMeasurement.props" />
</Project>
